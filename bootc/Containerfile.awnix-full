# ═══════════════════════════════════════════════════════════════════════════════
# awnix-full — every aw* package there is
#
# Build: podman build -t awnix-full:latest -f Containerfile.awnix-full .
#        (requires awnix-base:latest)
# Licence: Apache-2.0, same as the packages it carries.
# ═══════════════════════════════════════════════════════════════════════════════
#
# The base ships SEVEN tools: the ones a stranger needs to be handed a machine an agent
# can work in. This ships all TWENTY-SIX, for someone who wants the whole toolkit
# without choosing which pieces they will want later.
#
# TWO SOURCES, AND THE SPLIT IS NOT ABOUT MATURITY. Ten are on PyPI and sixteen are not
# -- because PyPI caps how many projects an account may create and we ran out of slots,
# not because those sixteen are unfinished. Every one has a public repo under
# github.com/Aitherium (all verified 200 on 2026-08-21), and reading a 404 on the index
# as "not ready" is what kept eleven of them unreachable from this image family.
FROM localhost/awnix-base:latest

# Published to PyPI. Faster, pinned, and needs neither git nor a compiler at build time,
# so it goes first and stays a separate layer from the source installs below -- a PyPI
# outage and a GitHub outage should not invalidate each other's cache.
#
# awgit awgraph awrelay awm awshare are already in the base; the rest are added here.
RUN python3.11 -m pip install --no-cache-dir \
        awprism awreason awrecurse awrepl awsync \
    && python3.11 -m pip list 2>/dev/null | grep -qi '^awprism' \
    || (echo "awprism did not install" >&2; exit 1)

# From source. Pinned to a branch rather than floating on a default: an image that
# resolves differently on every rebuild is not immutable, which is the one property
# awnix sells. Bump these deliberately.
#
# awrecover and awseal are already in the base (it needs all seven); the rest are here.
# `git` is installed in the base, so a git+https target resolves without another layer.
RUN python3.11 -m pip install --no-cache-dir \
        "git+https://github.com/Aitherium/awbac.git@main" \
        "git+https://github.com/Aitherium/awbrowse.git@main" \
        "git+https://github.com/Aitherium/awdit.git@main" \
        "git+https://github.com/Aitherium/awfind.git@main" \
        "git+https://github.com/Aitherium/awiam.git@main" \
        "git+https://github.com/Aitherium/awkno.git@main" \
        "git+https://github.com/Aitherium/awmail.git@main" \
        "git+https://github.com/Aitherium/awnboard.git@main" \
        "git+https://github.com/Aitherium/awnest.git@main" \
        "git+https://github.com/Aitherium/awnet.git@main" \
        "git+https://github.com/Aitherium/awpredict.git@main" \
        "git+https://github.com/Aitherium/awresearch.git@main" \
        "git+https://github.com/Aitherium/awrun.git@main" \
        "git+https://github.com/Aitherium/awtunnel.git@main"

# Assert the whole set IMPORTS, not merely that pip exited 0. A package can install and
# fail to import -- a missing runtime dep, a namespace collision -- and the difference
# only shows up on the user's machine, at the moment they reach for the thing they
# installed this variant to get.
RUN python3.11 - <<'PY'
import importlib.util, sys
mods = ["awgit","awgraph","awrelay","awm","awshare","awrecover","awseal",
        "awprism","awreason","awrecurse","awrepl","awsync",
        "awbac","awbrowse","awdit","awfind","awiam","awkno","awmail",
        "awnboard","awnest","awnet","awpredict","awresearch","awrun","awtunnel"]
missing = [m for m in mods if importlib.util.find_spec(m) is None]
if missing:
    sys.exit("awnix-full: these installed but do not import: " + ", ".join(missing))
print(f"awnix-full: all {len(mods)} aw* packages import")
PY

LABEL com.aitheros.layer="awnix-full" \
      com.aitheros.base="awnix" \
      com.aitheros.description="awnix + every aw* package (26)" \
      org.opencontainers.image.licenses="Apache-2.0"
