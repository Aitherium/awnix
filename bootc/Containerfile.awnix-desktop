# ═══════════════════════════════════════════════════════════════════════════════
# awnix-desktop — the aw* stack, a brain, and AitherDesktop AS the GUI.
#
# NOT Containerfile.desktop. That file installs @gnome-desktop on top of the
# PRIVATE aitheros-bootc-base appliance: a full desktop environment on an
# internal image. This is a different product — awnix with AitherDesktop as the
# ONLY graphical client, on a compositor whose whole job is to run it. There is
# no session to log into, no file manager, no second app. The overlay IS the
# machine's face, which is what "AitherDesktop as the GUI" has to mean if it
# means anything.
#
# Built on awnix-ai-full, not awnix-full: AitherDesktop talks to a model, and an
# appliance whose face cannot answer until someone configures a network endpoint
# is a worse product than one that answers on first boot. Same reasoning
# gobbonet-appliance records for baking a model in.
#
# LICENSING, and why this variant is PUBLISHED rather than withheld.
#
# A first draft made this publish: false on the grounds that AitherDesktop is
# BUSL-1.1 while the other variants are Apache-2.0. That reasoning was wrong, and
# the owner's own licence text is why:
#
#   awnix/LICENSE                       Apache-2.0 (the OS tree and the aw* packages)
#   LICENSE  "Licensed Work: AitherOS"  BUSL-1.1, Additional Use Grant = production
#                                       use for personal, non-commercial purposes;
#                                       commercial/organizational use needs a licence.
#                                       Change Date 2030-02-07 -> Apache-2.0.
#
# That grant exists SO the work can be shipped publicly: an individual runs it free,
# a company buys a licence. Withholding the image gives that up and gains nothing.
# There is also no conflict to resolve -- Apache-2.0 is permissive and redistributes
# cleanly inside a BUSL-licensed aggregate. The error is only the REVERSE: an image
# carrying BUSL code while declaring itself Apache-2.0.
#
# So this is a LABELLING requirement, not a publication one, and it is enforced
# rather than promised: the variant declares BUSL-1.1 in awnix-variants.yaml, this
# file's LABEL says the same, both licence texts ship in the image, and
# check_awnix_variants asserts the two agree -- so no image can be published
# claiming a licence its contents contradict.
#
# Build: podman build -t awnix-desktop:latest -f Containerfile.awnix-desktop .
#        (requires awnix-ai-full:latest)
# ═══════════════════════════════════════════════════════════════════════════════
FROM localhost/awnix-ai-full:latest

# A COMPOSITOR, not a desktop environment. The machine runs one Wayland client
# fullscreen and nothing else -- no session to log into, no file manager.
#
# MEASURED against the real base image (quay.io/centos-bootc/centos-bootc:stream9)
# rather than assumed, because a first draft of this file could not have built:
#
#   cage, wlr-randr             absent from base, EPEL and CRB entirely
#   python3-pyqt6-webengine     packaged NOWHERE for el9
#   python3-pyqt6               epel-next only, and only the non-WebEngine half
#   seatd, python3-aiohttp,
#   python3-httpx               EPEL
#   weston                      EPEL, 8.0.0
#   mesa-*, xkeyboard-config    base appstream
#
# So: weston, not cage. And weston 8 has neither kiosk-shell (9.0+) nor an
# [autolaunch] section -- both checked in the shipped man page, not assumed -- so the
# compositor and the app are TWO units against a named socket. That uses only
# long-standing weston features and cannot break on a version bump that changes
# shell plugins.
RUN dnf install -y --setopt=install_weak_deps=False epel-release \
    && dnf install -y --setopt=install_weak_deps=False \
        weston seatd \
        mesa-dri-drivers mesa-vulkan-drivers xkeyboard-config \
        python3-aiohttp python3-httpx python3-pyyaml python3-pip \
    && dnf clean all \
    && systemctl enable seatd.service

# PyQt6 from PIP, and this reverses a first draft that said the opposite.
#
# The original reasoning -- "dnf, because pip wheels bundle their own Qt and two Qt
# runtimes in one image is a support problem" -- was right about the hazard and wrong
# about which choice avoids it. PyQt6-WebEngine is packaged nowhere for el9, so dnf
# CANNOT supply a complete set; taking python3-pyqt6 from epel-next and the WebEngine
# half from pip is what would produce two Qt runtimes. One source is the fix, and pip
# is the only source that has both halves.
RUN python3 -m pip install --no-cache-dir \
        "PyQt6>=6.5.0" "PyQt6-WebEngine>=6.5.0" \
        "pynput>=1.7.6" "watchdog>=3.0.0"

# The app. Staged from the monorepo rather than pip-installed from an index:
# ecosystem.yaml records awdesk as `status: unpublished` with "see the repo" as
# its install instruction, so there is nothing to `pip install` and pretending
# otherwise would produce an image that fails to build on the day the ARG
# pointed somewhere real.
#
# --no-deps is deliberate: every runtime dependency is already installed above --
# aiohttp/httpx/pyyaml from EPEL, the Qt stack from pip -- and letting pip resolve
# them again could pull a second copy of either. The import check below is what
# proves that set is actually sufficient rather than assumed.
# Its OWN named build context, not a path under a repo-root one. The appliance
# layer records why: with a single repo-root context, buildah FILTERS the
# deploy files out -- "no items matching glob ... (1 filtered out)" -- which
# reads as a missing file while the file sits there. Each context resolves its
# own ignores, so a context pointed straight at the app cannot be filtered by a
# rule written somewhere above it.
COPY --from=deskapp . /opt/aither-desktop
# An image that restricts commercial use and does not carry the text
# saying so is not something a user can comply with. Both, because the
# aggregate really is both.
COPY --from=repo LICENSE /usr/share/licenses/awnix-desktop/LICENSE.BUSL-1.1
COPY --from=repo awnix/LICENSE /usr/share/licenses/awnix-desktop/LICENSE.Apache-2.0
RUN python3 -m pip install --no-deps --no-cache-dir /opt/aither-desktop \
    && python3 -c "import aither_desktop" \
    && command -v aither-desktop

# The unprivileged account the session runs as. `bonsai` already exists from
# awnix-ai-full and owns the inference side; a GUI session is a different job,
# so it gets its own user and its own seat membership.
#
# The uid is EXPLICIT and the units below use the same number. A first draft let
# useradd pick -- which takes whatever the layers below happened to leave free
# (awnix-runner creates `runner`, awnix-ai-full creates `bonsai`) -- while the units
# hardcoded /run/user/1001. The two would silently disagree the moment another
# account is added anywhere lower in the chain, and the symptom is a compositor
# that cannot create its runtime dir on a machine with no console to read.
# SUID001 says the same thing for the fleet's shared volumes: an account created
# with no explicit uid is a defect in its own right, because it moves under you.
ARG DESK_UID=1005
RUN useradd -m -u ${DESK_UID} -s /bin/bash \
        -c "AitherDesktop session (unprivileged)" desk \
    && usermod -aG seat,video,input,render desk \
    && test "$(id -u desk)" = "${DESK_UID}"

# TWO units against a named socket, because weston 8 has no kiosk-shell and no
# [autolaunch] -- both checked in the shipped man page. Each half is simple and
# independently verifiable, and neither depends on a shell plugin that a version
# bump might rename.
#
# XDG_RUNTIME_DIR and WAYLAND_DISPLAY are set EXPLICITLY rather than inherited: a
# graphical unit that relies on a login session's environment works when you test
# it over ssh with a session open and fails on a headless first boot, which is the
# only boot that matters here.
RUN mkdir -p /etc/xdg/weston \
 && printf '%s\n' \
      '[core]' 'idle-time=0' 'require-input=false' \
      '[shell]' 'locking=false' 'panel-position=none' \
      > /etc/xdg/weston/weston.ini

RUN cat > /etc/systemd/system/aither-weston.service <<'UNIT'
[Unit]
Description=Weston compositor hosting AitherDesktop (no desktop environment)
After=seatd.service
Wants=seatd.service

[Service]
Type=simple
User=desk
PAMName=login
TTYPath=/dev/tty2
Environment=XDG_RUNTIME_DIR=/run/user/1005
ExecStartPre=/usr/bin/install -d -o desk -g desk -m 0700 /run/user/1005
ExecStart=/usr/bin/weston --socket=aither-wl --backend=drm-backend.so
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
UNIT

RUN cat > /etc/systemd/system/aither-desktop.service <<'UNIT'
[Unit]
Description=AitherDesktop as the machine's GUI (the only Wayland client)
After=aither-weston.service awnix-bonsai.service
Requires=aither-weston.service

[Service]
Type=simple
User=desk
Environment=XDG_RUNTIME_DIR=/run/user/1005
Environment=WAYLAND_DISPLAY=aither-wl
Environment=XDG_SESSION_TYPE=wayland
Environment=QT_QPA_PLATFORM=wayland
# The overlay reaches the ecosystem over awnode's HTTP/SSE port on this box.
Environment=AITHER_AWNODE_URL=http://127.0.0.1:8099
ExecStart=/usr/bin/aither-desktop
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
UNIT

# Restart=always on both because the overlay IS the face of the machine: if it
# dies, a black screen is not an acceptable resting state.
RUN systemctl enable aither-weston.service aither-desktop.service
# tty1 stays with awnix-setup (it declares TTYPath=/dev/tty1 and
# Before=getty@tty1). This unit takes tty2 instead of masking that flow: unlike
# the private appliance, this image is NOT pre-provisioned, so the hostname,
# component-picker and fleet-link steps are exactly as useful here as on plain
# awnix. Two consoles, no race, both flows intact.

LABEL com.aitheros.layer="awnix-desktop" \
      com.aitheros.base="awnix-ai-full" \
      com.aitheros.description="awnix + the aw* stack + Bonsai + AitherDesktop as the only GUI client (weston, no desktop environment)" \
      org.opencontainers.image.licenses="BUSL-1.1" \
      com.aitheros.licence-note="Apache-2.0 aw* packages inside a BUSL-1.1 aggregate. Personal non-commercial production use granted; commercial use requires a licence; converts to Apache-2.0 on 2030-02-07."
