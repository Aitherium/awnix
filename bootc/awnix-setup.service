[Unit]
# awnix first-boot setup — the questions any Linux asks after install.
#
# ConditionPathExists=! is the "run once" mechanism, and it is deliberately DECLARATIVE
# rather than a flag file the script manages: the state file the setup writes IS the
# marker, so there is exactly one fact on disk and no way for "setup finished" and
# "marker written" to disagree. Delete /etc/awnix/setup.json and the box asks again,
# which is also the documented way to re-run it.
Description=awnix first-boot setup
Documentation=https://github.com/Aitherium/awnix
ConditionPathExists=!/etc/awnix/setup.json

# network-online is WANTED, not REQUIRED. The component menu and the link step both need
# the network, but a box with no network yet must still finish setup -- awnix-setup
# reports "could not check" for each package rather than pretending they are absent, and
# the link step is optional anyway. Requiring the network here would leave a first boot
# hanging on a machine whose only problem is an unplugged cable.
Wants=network-online.target
After=network-online.target systemd-user-sessions.service
Before=getty@tty1.service

[Service]
Type=oneshot
ExecStart=/usr/bin/awnix-setup
RemainAfterExit=no

# It is an interactive prompt, so it needs a real terminal. Without these it runs with no
# stdin, every input() returns EOF, and setup "completes" having asked nothing -- which
# looks like a working first boot and silently declines every choice for the user.
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

# A failed or cancelled setup must not brick the boot. The box is fully usable without
# ever answering these questions -- that is awnix's whole posture -- so a non-zero exit
# is logged and the machine carries on to a login prompt.
SuccessExitStatus=0 130

[Install]
WantedBy=multi-user.target
