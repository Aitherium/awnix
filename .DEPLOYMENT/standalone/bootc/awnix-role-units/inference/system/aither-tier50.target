# AUTO-GENERATED by deploy/generate-deploy-units.py from config/services.yaml
# Boot tier 50 -- reached only after aither-tier4.target.
# Do not edit manually -- re-run the generator instead.
#
# Install to /etc/systemd/system (NOT /etc/containers/systemd: systemd does
# not read that directory, and quadlet ignores a non-quadlet extension there,
# so a .target dropped beside the .container files is inert -- and a unit
# WantedBy= an inert target does not start LATE, it does not start).
# A rung ABOVE the base ladder (0-3). It exists because services.yaml
# declares it, and it is reached only after every base tier is up, so
# nothing on it competes with the platform coming up.

[Unit]
Description=AitherOS Boot Tier 50
After=aither-tier4.target
Wants=aither-tier4.target

[Install]
WantedBy=multi-user.target
