# ==============================================================================
# awnix-desktop-open -- a keyboard-first tiling desktop on the agent OS.
#
# WHY A FEDORA BASE. Measured 2026-09-26: CentOS Stream 9 + EPEL + CRB package no
# tiling Wayland compositor at all -- sway, waybar, wofi, mako, greetd and cage are
# absent; weston is the only compositor. fedora-bootc:42 ships every piece (sway 1.10,
# waybar, foot, wofi, mako, greetd/tuigreet, tesseract, whisper-cpp, greenboot), so
# the open desktop is a bootc image on that base rather than a source build on el9.
# The awnix-desktop variant (weston + AitherDesktop, BUSL-1.1) is unchanged.
#
# What it is:
#   sway + waybar + foot + wofi + mako, greetd/tuigreet login, one palette
#   Super+A      awsh -- the agent, answering from the local model
#   Super+Space  launcher        Super+Ctrl+Print  screen text -> clipboard (tesseract)
#   awdk + awsh baked in; greenboot rolls a failed update back (same check as awnix)
#
# Build: podman build -t awnix-desktop-open:latest -f Containerfile.awnix-desktop-open .
# Licence: Apache-2.0 AND BUSL-1.1. The desktop's own files are Apache-2.0; awdk and
# @aitherium/awsh, installed below, are BUSL-1.1. The label names both and the texts
# ship in /usr/share/licenses/awnix-desktop-open/ (check_awnix_variants.py
# AWV012/AWV013).
# ==============================================================================
FROM quay.io/fedora/fedora-bootc:42@sha256:077182b6ba853b3348d0bede602ac30b9e6568c6422bcf0654de5af96f19b9c3

RUN dnf -y install --setopt=install_weak_deps=False \
        sway swaybg swayidle swaylock waybar foot wofi mako \
        grim slurp wl-clipboard tesseract \
        greetd tuigreet \
        greenboot \
        python3-pip nodejs npm git curl jq \
        fonts-filesystem google-noto-sans-mono-fonts \
    && dnf clean all

# awdk and awsh are PINNED, by hash, not "the newest on the day of the build": the
# desktops on top of this layer auto-start awdk's daemons for every user, so which
# awdk ships decides what those daemons trust (check_awnix_desktop.py AWDK012).
#   awdk  desktop-open/awdk-requirements.txt -- awdk and its whole closure at the
#         component lock's versions, every line hash-pinned; --require-hashes refuses
#         anything else and --no-deps refuses anything unlisted.
#   awsh  desktop-open/awsh-npm/package-lock.json -- @aitherium/awsh and every
#         dependency at an exact version and sha512 integrity; `npm ci` refuses a
#         tarball that does not match.
COPY desktop-open/awdk-requirements.txt /tmp/awdk-requirements.txt
RUN python3 -m pip install --no-cache-dir --require-hashes --no-deps --only-binary=:all: \
        -r /tmp/awdk-requirements.txt \
    && rm -f /tmp/awdk-requirements.txt \
    && adk --help >/dev/null
# On a bootc image /root is a symlink into /var, which is empty at build time, so npm
# cannot create its cache there. Give it a throwaway home for the install.
COPY desktop-open/awsh-npm/package.json desktop-open/awsh-npm/package-lock.json /usr/lib/awsh-npm/
RUN cd /usr/lib/awsh-npm \
    && HOME=/tmp/npmhome npm ci --omit=dev --no-audit --no-fund --cache /tmp/npmhome/cache \
    && rm -rf /tmp/npmhome \
    && ln -sf /usr/lib/awsh-npm/node_modules/.bin/awsh /usr/bin/awsh \
    && command -v awsh \
    && awsh --version >/dev/null

# The licence texts the label names, each a byte copy of its repo source (AWV013):
# awnix/LICENSE, awdk/LICENSE and .PRODUCTS/.AITHERSHELL/cli/LICENSE (awsh).
COPY licenses/LICENSE.Apache-2.0 licenses/LICENSE.BUSL-1.1.awdk licenses/LICENSE.BUSL-1.1.awsh /usr/share/licenses/awnix-desktop-open/

COPY desktop-open/awnix.conf /etc/sway/config.d/50-awnix.conf

# Login: tuigreet on tty1 starts sway. greetd runs the greeter as its own user.
RUN printf '[terminal]\nvt = 1\n\n[default_session]\ncommand = "tuigreet --time --remember --cmd sway"\nuser = "greetd"\n' \
        > /etc/greetd/config.toml \
    && systemctl enable greetd.service \
    && systemctl set-default graphical.target

# Self-healing updates, identical to Containerfile.awnix: every greenboot unit with an
# [Install] section is enabled and the build fails if the health check is not.
RUN for u in $(rpm -ql greenboot | grep -E '/systemd/system/[^/]+\.(service|target)$'); do \
         grep -q '^\[Install\]' "$u" && systemctl enable "$(basename "$u")"; \
       done; \
    systemctl is-enabled greenboot-healthcheck.service
COPY awnix-health-check.sh /etc/greenboot/check/required.d/10-awnix-core.sh
RUN chmod 0755 /etc/greenboot/check/required.d/10-awnix-core.sh \
    && printf 'GREENBOOT_MAX_BOOT_ATTEMPTS=3\n' > /etc/greenboot/greenboot.conf

# fedora-bootc names no default root filesystem (CentOS bootc does), and
# bootc-image-builder refuses the ISO without one: "cannot build manifest: no default
# root filesystem type specified in container". bootc reads this at install time.
RUN mkdir -p /usr/lib/bootc/install \
    && printf '[install.filesystem.root]\ntype = "xfs"\n' > /usr/lib/bootc/install/00-awnix.toml

# Fails the build if the desktop would not start: sway must parse its config.
# /usr/bin/sway carries a file capability (cap_sys_nice) that a build container cannot
# grant, so exec'ing it here is EPERM (126). A plain copy drops the xattr and parses
# the same config.
RUN cp /usr/bin/sway /tmp/sway-validate \
    && mkdir -p -m 0700 /tmp/xdg \
    && XDG_RUNTIME_DIR=/tmp/xdg WLR_BACKENDS=headless WLR_RENDERER=pixman \
       WLR_LIBINPUT_NO_DEVICES=1 /tmp/sway-validate --validate --config /etc/sway/config \
    && rm -rf /tmp/sway-validate /tmp/xdg \
    && bootc container lint

LABEL com.aitheros.layer="awnix-desktop-open" \
      com.aitheros.description="awnix open desktop: sway tiling Wayland, Super+A local agent, greenboot rollback" \
      org.opencontainers.image.licenses="Apache-2.0 AND BUSL-1.1" \
      com.aitheros.licence-note="Apache-2.0 and MIT aw* packages plus two BUSL-1.1 packages, awdk and @aitherium/awsh, each licensed by Aitherium Inc. with the Additional Use Grant that you may not use the Licensed Work for a Commercial Hosted Service. The Apache-2.0 text and both BUSL-1.1 texts ship in /usr/share/licenses/awnix-desktop-open/."
