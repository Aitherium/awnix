  "roles": {
    "backup": {
      "config": {
        "AITHER_BACKUP_DIR": {
          "default": "/data/backups",
          "description": "Where Recover writes backup sets (inside the container).",
          "type": "string"
        },
        "AITHER_PG_DUMP_DIR": {
          "description": "Staging directory for Postgres dumps.",
          "type": "string"
        }
      },
      "data_volumes": [
        "backups"
      ],
      "deploy": [],
      "entitlement": [
        "core"
      ],
      "hooks": {
        "backup": {
          "http": "POST /recover/backup/now",
          "service": "Recover"
        },
        "replicate": {
          "none": "Recover's backup already carries its GitHub/R2 legs; awrtifact offsite copies are an owner-host tool, not on the box"
        },
        "restore": {
          "http": "POST /recover/restore/now",
          "service": "Recover"
        }
      },
      "removable": true,
      "requires_roles": [
        "identity",
        "storage"
      ],
      "ring": "feature",
      "services": [
        "Recover"
      ],
      "title": "Backup & Recovery"
    },
    "identity": {
      "config": {
        "AITHER_DEVICE_VERIFICATION_URL": {
          "description": "Public URL of the device-code verification page served by Identity.",
          "type": "string"
        },
        "AITHER_FRONTEND_URL": {
          "description": "Portal URL Identity puts in login and verification redirects.",
          "type": "string"
        },
        "AITHER_MASTER_KEY": {
          "description": "Master key Identity reads; the value lives in the vault, never in the env file.",
          "required": true,
          "secret_ref": "AITHER_MASTER_KEY",
          "type": "secret"
        }
      },
      "data_volumes": [
        "Library/Data/secrets",
        "Library/Data/identity",
        "data/aither-data/directory"
      ],
      "deploy": [
        "SecurityCore",
        "Directory",
        "Secrets"
      ],
      "entitlement": [
        "core"
      ],
      "hooks": {
        "backup": {
          "steps": [
            {
              "auth": "api-key",
              "expect": {
                "success": true
              },
              "http": "POST /backup",
              "service": "Secrets"
            },
            {
              "http": "GET /directory/platform/backup/sqlite",
              "save_to": "{backup_dir}/identity/{ts}/directory.db",
              "service": "Directory"
            }
          ]
        },
        "replicate": {
          "none": "Directory DIT replication is Postgres physical streaming, disabled in services.yaml replication.directory_dit (0 rows streaming); no on-demand route exists"
        },
        "restore": {
          "auth": "api-key",
          "expect": {
            "success": true
          },
          "http": "POST /restore?source={source}",
          "note": "vault from lockbox|strata|vault (--param source=auto). The DIT is restored by POST /recover/backup/sets/restore into an EMPTY scratch dir and proven by /recover/backup/sets/identity-drill; moving it into place is a human act by design.",
          "service": "Secrets"
        }
      },
      "removable": false,
      "requires_roles": [],
      "ring": "platform",
      "services": [
        "SecurityCore",
        "Identity",
        "Directory",
        "Secrets"
      ],
      "title": "Identity & Directory"
    },
    "inference": {
      "config": {
        "AITHER_DEFAULT_MODEL": {
          "default": "aither-orchestrator",
          "description": "Model alias requests route to when none is named. WHICH weights serve it is the model posture (config/model-postures.yaml `active`), changed only through `awmodels use`, never by this role.",
          "type": "string"
        }
      },
      "data_volumes": [
        "aither-llm-traces"
      ],
      "deploy": [
        "MicroScheduler"
      ],
      "entitlement": [
        "core"
      ],
      "hooks": {
        "backup": {
          "none": "stateless router: which weights serve is config/model-postures.yaml (awmodels); aither-llm-traces is diagnostic only"
        },
        "replicate": {
          "none": "stateless router -- nothing to replicate"
        },
        "restore": {
          "none": "stateless router -- nothing to restore; re-apply the posture with awmodels use"
        }
      },
      "removable": true,
      "requires_roles": [],
      "ring": "feature",
      "services": [
        "MicroScheduler"
      ],
      "title": "Inference Routing"
    },
    "mail": {
      "config": {
        "AITHER_ADMIN_EMAIL": {
          "description": "Where operator mail is addressed.",
          "type": "string"
        },
        "AITHER_SMTP_HOST": {
          "description": "Outbound SMTP relay host AitherMail hands mail to.",
          "required": true,
          "type": "string"
        }
      },
      "data_volumes": [
        "Library/Data/mail"
      ],
      "deploy": [
        "MailCore"
      ],
      "entitlement": [
        "addon:business"
      ],
      "hooks": {
        "backup": {
          "body": {
            "backup_dir": "/data/backups",
            "backup_id": "role-mail-{ts}",
            "include_github": false,
            "include_strata": false,
            "paths": [
              "/app/AitherOS/Library/Data/mail"
            ]
          },
          "http": "POST /recover/local/backup/now",
          "service": "SecurityCore"
        },
        "replicate": {
          "none": "mail is a single-box relay with no peer copy; off-box copies are the backup role's job"
        },
        "restore": {
          "http": "POST /recover/local/restore?backup_id={backup_id}",
          "note": "--param backup_id=role-mail-<ts> (GET /recover/local/backups lists them)",
          "service": "SecurityCore"
        }
      },
      "removable": true,
      "requires_roles": [
        "identity"
      ],
      "ring": "feature",
      "services": [
        "MailCore",
        "Mail"
      ],
      "title": "Mail"
    },
    "platform": {
      "config": {},
      "data_volumes": [
        "aither-factory-workspace",
        "aither-pack-data",
        "business-pilot-data",
        "calibration-data",
        "marketplace-data",
        "plans-db",
        "saga-data",
        "selfserve-shop-data"
      ],
      "deploy": [
        "Genesis"
      ],
      "entitlement": [
        "core"
      ],
      "hooks": {
        "backup": {
          "volumes": "export"
        },
        "replicate": {
          "none": "HA is the genesis/genesis-standby pair (a second unit), not a data copy a hook can trigger"
        },
        "restore": {
          "note": "stop aither-genesis first; --param from=<backup_dir>/platform/<ts>",
          "volumes": "import"
        }
      },
      "removable": false,
      "requires_roles": [],
      "ring": "kernel",
      "services": [
        "Genesis"
      ],
      "title": "Platform Orchestration"
    },
    "replication-partner": {
      "config": {
        "AITHER_REPLICATION_DB_DIR": {
          "default": "/data/replication",
          "description": "Where replication job state is persisted.",
          "type": "string"
        },
        "MESH_REPL_WHOLE_FILE_CONCURRENCY": {
          "default": 1,
          "description": "Whole-file replication transfers run in parallel.",
          "type": "int"
        }
      },
      "data_volumes": [
        "aither-strata-mesh-repl-state"
      ],
      "deploy": [
        "StrataMeshReplicationTrigger"
      ],
      "entitlement": [
        "addon:mesh"
      ],
      "hooks": {
        "backup": {
          "volumes": "export"
        },
        "replicate": {
          "body": {
            "path": "{path}"
          },
          "http": "POST /strata/mesh/replicate",
          "note": "--param path=aither://...",
          "service": "Strata"
        },
        "restore": {
          "note": "stop aither-stratameshreplicationtrigger first; --param from=<backup_dir>/replication-partner/<ts>",
          "volumes": "import"
        }
      },
      "removable": true,
      "requires_roles": [
        "storage"
      ],
      "ring": "feature",
      "services": [
        "StrataMeshReplicationTrigger"
      ],
      "title": "Replication Partner"
    },
    "storage": {
      "config": {
        "MINIO_ENDPOINT": {
          "description": "S3/MinIO endpoint for the cold tier (empty = local tiers only).",
          "type": "string"
        },
        "MINIO_SECRET_KEY": {
          "description": "Cold-tier credential (vault).",
          "secret_ref": "MINIO_SECRET_KEY",
          "type": "secret"
        }
      },
      "data_volumes": [
        "aither-strata-data",
        "aither-strata-appdata"
      ],
      "deploy": [
        "Strata"
      ],
      "entitlement": [
        "core"
      ],
      "hooks": {
        "backup": {
          "body": {},
          "http": "POST /strata/backup/create",
          "service": "Strata"
        },
        "replicate": {
          "body": {
            "path": "{path}"
          },
          "http": "POST /strata/mesh/replicate",
          "note": "replicates ONE Strata path to mesh peers: --param path=aither://...",
          "service": "Strata"
        },
        "restore": {
          "http": "POST /strata/backup/restore/{backup_id}",
          "note": "--param backup_id=<id from GET /strata/backup/list>",
          "service": "Strata"
        }
      },
      "removable": false,
      "requires_roles": [
        "identity"
      ],
      "ring": "platform",
      "services": [
        "Strata"
      ],
      "title": "Storage (Strata)"
    },
    "web-portal": {
      "config": {
        "AITHER_TUNNEL_DATA": {
          "description": "Directory the Tunnel keeps peer and route state in.",
          "type": "string"
        }
      },
      "data_volumes": [
        "aitheros-acta-data",
        "marketplace-data",
        "aither-tunnel-data"
      ],
      "deploy": [
        "Veil",
        "PortalGateway",
        "Tunnel"
      ],
      "entitlement": [
        "addon:automation",
        "addon:mesh"
      ],
      "hooks": {
        "backup": {
          "volumes": "export"
        },
        "replicate": {
          "none": "the portal serves one box; mesh replication is the replication-partner role's"
        },
        "restore": {
          "note": "stop the web-portal units first; --param from=<backup_dir>/web-portal/<ts>",
          "volumes": "import"
        }
      },
      "removable": true,
      "requires_roles": [
        "identity",
        "platform"
      ],
      "ring": "feature",
      "services": [
        "Veil",
        "PortalGateway",
        "Tunnel"
      ],
      "title": "Web Portal"
    }
  },
