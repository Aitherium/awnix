# awdk vendor environment (awnix base / ai-full). Installed at /usr/lib/awdk/awdk.env.
# Admin overrides go in /etc/awdk/awdk.env (read after this file; later wins).
# Local llama.cpp served by serve-awnix-bonsai on loopback :8199.
AITHER_LLM_BASE_URL=http://127.0.0.1:8199/v1
AITHER_LLM_STRICT_BASE_URL=1
AITHER_OFFLINE=1
AITHER_AIR_GAP_CONFIG=/usr/lib/awdk/air_gap.yaml
