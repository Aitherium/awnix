# /usr/lib/gargbot/appliance.env.d/90-airgap.env -- airgap profile only.
#
# Takes effect once garg-firstboot sources appliance.env.d/*.env and honours
# these two keys (handoff). Until then `awnix-zero-ports verify-static` FAILS a
# garg airgap build whose firstboot still hardcodes --host 0.0.0.0, because the
# claim would be false.
GARGBOT_BIND_HOST=127.0.0.1
GARG_QDRANT_HOST=127.0.0.1
AWNIX_PROFILE=airgap
