[Unit]
Description=Generate + start the migrated AitherOS fleet units once its data is bound
Documentation=file:///usr/libexec/aither/aither-attach-fleet-data.sh
# No ConditionPathExists on the env file: once /etc/aither is BOUND it is the fleet's dir and
# hides the image's env file. The attach unit gates on it BEFORE the bind; require that.
Requires=aither-attach-fleet-data.service
After=aither-attach-fleet-data.service basic.target network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# The quadlet generator ran at boot BEFORE /etc/containers/systemd was bound, so it
# generated nothing; re-run it now, then start what the fleet wants. default.target alone
# reached ~51 of ~140 on 2026-09-27: many deployed quadlets are wanted by nothing at
# boot, so every generated fleet unit is started explicitly too -- minus the deliberately
# MASKED ones (vllm-fp16 and 23 more): starting a masked unit fails, xargs exits 123 and
# this unit read `failed` on every boot (measured 2026-09-27 16:52) though the fleet came up.
# Also minus the CLIENT-WOKEN units (quiesce.yaml `wake: client`: voicecloner, mediaforge,
# remotionrenderer). Their generator gives them no WantedBy on purpose (lifecycle.boot: false);
# this catch-all started them anyway, and the voice cloner sat at ~7 cores from boot on
# 2026-09-27 (load 103/28). A caller wakes them; they park themselves when idle.
ExecStart=/bin/sh -c 'systemctl daemon-reload && systemctl enable --now podman-restart.service; for t in $(cd /etc/systemd/system && ls aither-tier*.target 2>/dev/null | sort -V); do systemctl start --no-block "$t"; done; systemctl start --no-block default.target; systemctl list-unit-files --state=masked,masked-runtime --no-legend | cut -d" " -f1 > /run/aither-masked-units; grep -oE "^ *aither-[A-Za-z0-9_.-]+[.]service: [{][^}]*wake: client" /mnt/c/AitherOS-Fresh/AitherOS/config/quiesce.yaml 2>/dev/null | sed -E "s/^ *//; s/:.*//" >> /run/aither-masked-units; ls /run/systemd/generator | grep -E "^(aither|aitheros|awdk).*[.]service$" | grep -vxFf /run/aither-masked-units | xargs -r systemctl start --no-block'
TimeoutStartSec=10min

[Install]
WantedBy=multi-user.target
