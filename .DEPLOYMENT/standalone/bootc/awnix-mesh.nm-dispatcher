#!/bin/sh
# NetworkManager dispatcher hook, installed as
# /usr/lib/NetworkManager/dispatcher.d/90-awnix-mesh (0755). When any connection comes
# up and an AitherMesh join is pending, finish it now instead of waiting for the timer.
# Never blocks NM: the service is started with --no-block.
[ "$2" = "up" ] || [ "$2" = "connectivity-change" ] || exit 0
[ -e /var/lib/awnix/mesh/pending.json ] || exit 0
[ "$1" = "aithernet0" ] && exit 0
exec systemctl start --no-block awnix-mesh.service
