# ==============================================================================
# awnix-ai-full - the aw* stack AND inference, in one image.
#
# THE RUNG THAT DID NOT EXIST. The public ladder was asked for as:
#     plain awnix  ->  awnix + the aw* stack core  ->  + Bonsai-27B (or smaller)
# and the first two shipped while the third did not. What shipped as `awnix-ai`
# is Containerfile.awnix-runner-ai: awnix-base -> awnix-runner -> +llama.cpp.
# That chain is built on the GITHUB ACTIONS RUNNER layer. It DOES carry the
# base's aw* stack -- Containerfile.awnix-runner is `FROM localhost/awnix-base`
# and runner-ai adds llama.cpp on top, so every brick the base installs is
# inherited (runner-ai asserts `import awgit, awm, awgraph, adk` to prove it,
# not assume it). What awnix-ai lacks is not the stack but the UI: it ships
# inference with the tools and no GobboNet front end, which is why this rung
# exists -- the stack AND inference AND the UI in one image.
#
# awnix-variants.yaml says this outright in the gobbonet-appliance entry:
#   "awnix-full ships the GobboNet UI with no inference and awnix-ai ships
#    inference with no UI -- an appliance needs both halves."
# The only image that had both halves was a customer appliance. This is those
# halves as a PUBLIC rung, with no customer app on top.
#
# Build: podman build -t awnix-ai-full:latest -f Containerfile.awnix-ai-full .
#        (requires awnix-full:latest)
# Licence: Apache-2.0 AND BUSL-1.1. The base it builds on installs awdk and
# @aitherium/awsh, both BUSL-1.1; the texts ship in /usr/share/licenses/awnix/
# (check_awnix_variants.py AWV012/AWV013).
# ==============================================================================

# Same throwaway stage, same reason as Containerfile.awnix-runner-ai: the
# PrismML binaries need a newer GLIBCXX than stream9 carries. Read the block
# comment at the top of that file before touching any of this -- the fix is
# deliberately SCOPED to /opt/bonsai/lib and one exec, and never replaces the
# base image's own libstdc++/libc/loader.
FROM quay.io/centos-bootc/centos-bootc:stream10@sha256:57cabe59d0332f9060a8d2768021d2c7457d855857ff2068a0566b3bd19b6cfa AS newer-libstdcxx
# Pinned by digest from base-images.lock (G9; bump with pin_awnix_base.py --refresh).
# Collect the five runtime files through their STABLE SONAME symlinks. This stage was a
# FLOATING tag, and two of the files used to be copied by their versioned names
# (libgcc_s-14-20260629.so.1, libstdc++.so.6.0.33). Upstream rebuilt gcc, the file
# became libgcc_s-14-20260724.so.1, and every image built FROM this one -- including
# the garg appliance -- stopped building (run 35603911911, 2026-09-21). `cp -L`
# dereferences libgcc_s.so.1 and libstdc++.so.6, which do not change name.
RUN mkdir -p /out && cp -L /usr/lib64/libstdc++.so.6 /usr/lib64/libgcc_s.so.1 \
        /usr/lib64/libc.so.6 /usr/lib64/libm.so.6 /lib64/ld-linux-x86-64.so.2 /out/ \
    && for f in libstdc++.so.6 libgcc_s.so.1 libc.so.6 libm.so.6 ld-linux-x86-64.so.2; do \
         test -s "/out/$f" || { echo "newer-libstdcxx: $f missing upstream" >&2; exit 1; }; done

FROM localhost/awnix-full:latest

# awnix-full has no unprivileged service account -- it is a toolkit image, not
# a runner. serve-awnix-bonsai.sh drops privileges to $BONSAI_USER and REFUSES
# to start if that account is missing, so create it here and name it for what
# it does. Calling it `runner` to match the other layer's hardcoded string is
# exactly the drift this rung exists to avoid.
#
# A SYSTEM account (uid < 1000), home under /var/lib. `useradd -m` without --system
# took uid 1000 -- the first HUMAN uid -- so on the awnix WSL cutover the migrated
# home (owned by uid 1000) and the first person to log in collided with an inference
# daemon (2026-09-27). An image bakes no human account; aither-setup creates that one
# at first boot. The home stays: serve-awnix-bonsai.sh runs `adk mesh onboard` as
# this user and adk writes ~/.aither.
RUN useradd --system --create-home --home-dir /var/lib/bonsai --shell /sbin/nologin \
        -c "awnix Bonsai inference (unprivileged)" bonsai \
    && test "$(id -u bonsai)" -lt 1000

# Prebuilt binary only, same release channel and same Vulkan reasoning as
# Containerfile.awnix-runner-ai: one small download that covers NVIDIA/AMD/Intel
# with no CUDA runtime. Pinned to the SAME build as that layer on purpose -- two
# public images serving different llama.cpp builds is a support surface nobody
# asked for.
# prism-b12128-d7b2896 (2026-10-31) is the pinned fork release: it ships the llama-*
# binaries and loads Hadamard v2, so it serves Bonsai 2 at EVERY size (2B/4B/9B/27B;
# prism-b10685 refused the small ones with "unsupported prism.hadamard.version: 2").
# Stock llama.cpp loads Bonsai 2 files and emits gibberish. Some fork tags (prism-b10687)
# ship no llama-* assets at all -- list a release's assets before pinning it.
# Same pin as install-bonsai.{sh,ps1} and assemble.sh.
# Vulkan lane => PTQ1_0 is the Bonsai 2 format for this image (awnix-models.yaml).
ARG PRISM_RELEASE=prism-b12128-d7b2896
ARG PRISM_ASSET=llama-prism-b12128-d7b2896-bin-ubuntu-vulkan-x64.tar.gz
RUN mkdir -p /opt/bonsai/bin /opt/bonsai/models /opt/bonsai/lib \
    && curl -fsSL -o /tmp/llama.tar.gz \
        "https://github.com/PrismML-Eng/llama.cpp/releases/download/${PRISM_RELEASE}/${PRISM_ASSET}" \
    && tar -xzf /tmp/llama.tar.gz -C /opt/bonsai/bin \
    && rm /tmp/llama.tar.gz \
    && find /opt/bonsai/bin -name llama-server -type f -exec chmod +x {} \; \
    && chown -R bonsai:bonsai /opt/bonsai

# The scoped GLIBCXX chain. Identical to Containerfile.awnix-runner-ai.
COPY --from=newer-libstdcxx /out/libstdc++.so.6 /opt/bonsai/lib/libstdc++.so.6
COPY --from=newer-libstdcxx /out/ld-linux-x86-64.so.2 /opt/bonsai/lib/ld-linux-x86-64.so.2
COPY --from=newer-libstdcxx /out/libc.so.6 /opt/bonsai/lib/libc.so.6
COPY --from=newer-libstdcxx /out/libm.so.6 /opt/bonsai/lib/libm.so.6
COPY --from=newer-libstdcxx /out/libgcc_s.so.1 /opt/bonsai/lib/libgcc_s.so.1
RUN chmod 755 /opt/bonsai/lib/*.so* \
    && chown -R bonsai:bonsai /opt/bonsai/lib

# Launcher, CHOOSER and CATALOGUE -- all three, for the same reason the other
# layer ships all three: the launcher refuses to start without the selector
# rather than falling back to a built-in default, so the catalogue stays the
# source of truth. Weights are NOT baked (a 27B is larger than the whole ISO);
# the chooser sizes the model to the hardware at first boot, which is what
# "27B or smaller" actually requires.
COPY --chown=root:root serve-awnix-bonsai.sh /usr/local/sbin/serve-awnix-bonsai.sh
COPY --chown=root:root awnix-model-select.py /usr/local/sbin/awnix-model-select.py
COPY --chown=root:root awnix-models.yaml /usr/local/sbin/awnix-models.yaml
RUN chmod 755 /usr/local/sbin/serve-awnix-bonsai.sh /usr/local/sbin/awnix-model-select.py \
    && chmod 644 /usr/local/sbin/awnix-models.yaml

# Read by serve-awnix-bonsai.sh. Set in the IMAGE rather than passed by every
# caller: a launcher that needs an env var nobody remembers is a launcher that
# fails at first boot on the box that needed it.
ENV BONSAI_USER=bonsai
# Serve on boot with no operator (the script was otherwise only reachable via cloud-init).
COPY --chown=root:root awnix-bonsai.service /usr/lib/systemd/system/awnix-bonsai.service
RUN sed -i 's/\r$//' /usr/lib/systemd/system/awnix-bonsai.service \
    && systemctl enable awnix-bonsai.service \
    && test "$(systemctl is-enabled awnix-bonsai.service)" = enabled

# The image must LOAD a model, not merely start llama-server: on 2026-09-27 this
# image passed every other check and shipped unable to load any model (#9468).
# Runs the real serve script on the smallest LADDER model and passes it explicitly:
# the default ladder starts at Bonsai 2 2B (PTQ1_0 / Hadamard v2, the path every
# pinned prism-b12128 image serves), not the superseded Bonsai 1.7B (PQ2_0).
# Weights are deleted before this layer closes. See awnix-model-load-check.sh.
COPY --chown=root:root awnix-model-load-check.sh /usr/local/libexec/awnix-model-load-check.sh
RUN AWNIX_CHECK_MODEL=bonsai2-2b bash /usr/local/libexec/awnix-model-load-check.sh

# ── adk pinned to the local model, by a SHIPPED file ───────────────────────────
# The ai-full image is the one customers run agents on, so awdk (adk) must point at
# the box's own llama.cpp on 127.0.0.1:8199 rather than the fleet or a cloud default.
# That pointer used to reach users only through awsh's package default; the vendor
# env, the loopback daemon and its boot proof sat in the repo uncopied, so `adk` on a
# fresh box had no local endpoint at all (BON2-06). Stage them and prove the units
# parse. check_awdk_on_awnix.py AWK005 enforces every line of this block.
COPY --chown=root:root awdk/awdk-local.service awdk/awdk-local-health.service /usr/lib/systemd/system/
COPY --chown=root:root awdk/air_gap.yaml awdk/awdk.env /usr/lib/awdk/
COPY --chown=root:root awdk/awnix-awdk.py /usr/libexec/awnix/awnix-awdk
RUN sed -i 's/\r$//' /usr/libexec/awnix/awnix-awdk /usr/lib/awdk/awdk.env \
    && chmod 0755 /usr/libexec/awnix/awnix-awdk \
    && /usr/libexec/awnix/awnix-awdk --self-test \
    && systemctl enable awdk-local.service awdk-local-health.service

# ── the memory half ────────────────────────────────────────────────────────────────
# These images ship llama.cpp (generation) and, until 2026-10-27, NOTHING that could
# embed -- so the box could generate and never remember. awembed's `serve` verb runs an
# exported student on onnxruntime (CPU, or CUDA where the runtime provides it) over
# /v1/embeddings; weights come from artifact.aitherium.com by RELEASE (awrtifact, added
# to the base the same day) instead of being baked, so a new model is a pull, not a rebuild.
RUN python3.11 -m pip install --no-cache-dir "awembed[serve]" onnxruntime

# Assert the import, do not assume it. An image that installs a package nobody can
# import is exactly the failure this file already records about its own aw* count.
RUN python3.11 -c "import onnxruntime; from awembed import serve; print('onnxruntime', onnxruntime.__version__)"

# Rewrite the baked inventory so `awnix component list` reports awembed (this layer's
# only first-party add) as baked alongside the full stack it inherits.
RUN /usr/libexec/awnix/awnix-baked-inventory --variant awnix-ai-full \
        --out /usr/share/awnix/components.d/baked.yaml

LABEL com.aitheros.layer="awnix-ai-full" \
      com.aitheros.base="awnix-full" \
      com.aitheros.description="Every aw* package plus PrismML llama.cpp -- the aw* stack WITH inference (model fetched and sized at first boot)" \
      org.opencontainers.image.licenses="Apache-2.0 AND BUSL-1.1" \
      com.aitheros.licence-note="Apache-2.0 and MIT aw* packages plus two BUSL-1.1 packages, awdk and @aitherium/awsh, each licensed by Aitherium, LLC with the Additional Use Grant that you may not use the Licensed Work for a Commercial Hosted Service. The Apache-2.0 text and both BUSL-1.1 texts ship in /usr/share/licenses/awnix/."
