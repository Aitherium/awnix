# ═══════════════════════════════════════════════════════════════════════════════
# awnix-dev — the shared dev sandbox image (owner ask, 2026-08-27)
#
# Build: podman build -t awnix-dev:latest -f Containerfile.awnix-dev .
#        (requires awnix-full:latest; the chain base -> full -> dev)
#
# This is the image the workspace sandbox lane spawns: a member of the vibe
# workspace creates a sandbox, the harness daemon provisions it, and a claude
# session runs INSIDE it. The old image for that lane was aitheros-dev-workspace
# (ubuntu:24.04 + a hand-picked toolset). This variant is the same promise on
# the awnix chain: immutable base, every aw* package, and the dev tools the
# workspace lane actually needs.
#
# PRIVATE, never published (awnix-variants.yaml `publish: private`): it carries
# the Claude Code CLI pinned to whatever the registry serves today, and it is
# the image the platform's own workspace lane spawns — the same reason the
# aitheros appliance may not be published.
#
# What comes from the chain (already in awnix-full, no reinstall):
#   nodejs/npm, pwsh 7, git, curl, python3.11, awdk (`adk`), @aitherium/shell-cli
#   (`aither` / `aither-shell`)
# What this layer adds:
#   gh (GitHub CLI), tmux, openssh-client, build toolchain, Claude Code CLI
# ═══════════════════════════════════════════════════════════════════════════════
FROM localhost/awnix-full:latest

# ── dev toolchain ─────────────────────────────────────────────────────────
# The base is dnf-based (os-release ID must stay `centos` — AWV006). These are
# the tools a shared dev sandbox needs that the chain does not carry.
# `gh` is NOT in the base repos — it ships in EPEL. Measured 2026-08-27:
# without epel-release, `dnf install gh` fails with "No match for argument:
# gh" (a build that looks like a typo and is a missing repo).
RUN dnf install -y epel-release \
    && dnf install -y gh tmux openssh-clients gcc gcc-c++ make which \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# ── Claude Code CLI ───────────────────────────────────────────────────────
# The harness daemon spawns `claude` sessions INSIDE sandbox containers, so
# the binary must be on PATH here — an image without it creates a session that
# dies on `command not found` while every probe of the container passes.
# Pinned to whatever npm serves at build time, like aitheros-dev-workspace did.
RUN npm install -g @anthropic-ai/claude-code@latest

# ── assert the image is what it claims, not merely built ───────────────────
# Every one of these is checked because each failed in a previous build of the
# dev-workspace lane: npm exits 0 while the shim cannot resolve; dnf can lag.
# `command -v` on each, and the claude binary must actually execute.
RUN set -eu; \
    command -v gh >/dev/null \
    && command -v tmux >/dev/null \
    && command -v ssh >/dev/null \
    && command -v claude >/dev/null \
    && claude --version >/dev/null 2>&1 \
    && python3.11 -c "import adk; print('adk ok')" \
    && echo AWNIX_DEV_STAGED_OK

LABEL com.aitheros.layer="awnix-dev" \
      com.aitheros.base="awnix-full" \
      com.aitheros.description="shared dev sandbox: aw* stack + claude CLI" \
      org.opencontainers.image.licenses="Apache-2.0"
