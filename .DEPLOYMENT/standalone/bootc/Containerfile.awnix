# ═══════════════════════════════════════════════════════════════════════════════
# awnix — the public OS layer
# A Linux you can hand to an agent: immutable base, capabilities included.
#
# NOT Containerfile.base. That file is the AitherOS *commercial appliance*
# base (Ollama, Cockpit, a 272-port firewall, an `aither` service account) —
# awnix is the opposite by design: "No services. No agent. No account."
# (AitherOS/config/ecosystem.yaml, awnix entry). Capabilities go in the base
# (the 19 aw* tools below); the AGENT layers on top separately (three
# lines in a Dockerfile — see the agent-runner layer this base is built for).
# Putting the agent in the base instead would mean swapping agents loses
# every guarantee the base provides.
#
# Build: podman build -t awnix-base:latest -f Containerfile.awnix .
# Licence: Apache-2.0 AND BUSL-1.1. The OS tree and the aw* bricks are Apache-2.0 (a
# few are MIT); awdk and @aitherium/awsh are BUSL-1.1, so the label names both and
# the licence texts ship in /usr/share/licenses/awnix/. Apache-2.0 packages
# redistribute cleanly inside the aggregate; an image carrying BUSL code while
# calling itself Apache-2.0 is the error (check_awnix_variants.py AWV012/AWV013).
# ═══════════════════════════════════════════════════════════════════════════════
FROM quay.io/centos-bootc/centos-bootc:stream9@sha256:216b78988500e61795076315ff095e952ed00507bf445bb625ae9e0df182fadb

# IMPORT THE SIGNING KEY BEFORE ANY dnf, and do not disable the check.
#
# Measured 2026-08-21 on the AWS build lane: the python3.11 step failed with
#   Public key for python3.11-3.11.13-10.el9.x86_64.rpm is not installed
#   GPG Keys are configured as: file:///etc/pki/rpm-gpg/RPM-GPG-KEY-centosofficial
#   Error: GPG check FAILED
# The repo config points at a key the rpm database has not imported, so dnf downloads
# every package successfully and then refuses all of them.
#
# Placed HERE rather than at the failing step: this file has three dnf installs and
# runner-ai has another. Only one failed, which invites fixing that one -- and then the
# next repo needing the same key fails later, at a step that looks unrelated. One
# import before the first install covers every subsequent layer, because the rpm
# database persists across them.
#
# `--nogpgcheck` would make this green in one character and is the wrong fix: awnix is
# an operating system people BOOT, and disabling signature verification while building
# it leaves the shipped image's provenance resting on nothing. Import the key already
# on disk instead -- same trust root, actually checked.
#
# `|| true`: a base image that has ALREADY imported it is not an error. If the import
# genuinely failed, the installs below still fail the GPG check -- loudly and for the
# right reason -- so this cannot mask the thing it exists to fix.
RUN rpm --import /etc/pki/rpm-gpg/RPM-GPG-KEY-centosofficial || true

# cloud-init is what makes a key-only box reachable on AWS/Hetzner/etc — it
# injects the launch keypair. Same reasoning as Containerfile.base (D-2070):
# no password AND no key path is unreachable, not secure.
RUN dnf install -y --setopt=install_weak_deps=False cloud-init \
    && systemctl enable cloud-init cloud-init-local cloud-config cloud-final \
    && dnf clean all

# Rootless podman only. No --privileged anywhere in this image, no NOPASSWD
# sudoers entry of any kind baked in here — see the security note in the
# awrun plan's Phase 15/16: docker/podman-group-equivalent-to-root and
# blanket NOPASSWD sudo are the same hole with extra steps, and awnix's own
# "no agent, no account" philosophy is the wrong place to compromise on it.
# C toolchain for the runner pool (SHW009). Measured 2026-08-21:
# node-gyp deps (better-sqlite3) died `gyp ERR! not found: make` on
# aitheros-aws-2; this image has never carried make/gcc/g++, so the
# aws pool could not compile any native npm module. The jobs on the
# pool are pinned for this in check_selfhosted_workflow_contract.py
# (SHW009_PIN); the pool is re-provisioned from this image so the
# pin can ratchet DOWN. patch is for node-gyp's apply step.
# NOTE (2026-08-31, AWV007): this comment MUST stay ABOVE the RUN — a
# comment between backslash continuations is prepended to the shell
# command, commenting out every package after it (the toolchain silently
# never installed; caught by check_awnix_variants.py).
# C toolchain for the runner pool (SHW009). Measured 2026-08-21: node-gyp deps
# (better-sqlite3) died `gyp ERR! not found: make` on aitheros-aws-2; this image
# had never carried make/gcc/g++, so the aws pool could not compile any native
# npm module. The jobs on the pool are pinned for this in
# check_selfhosted_workflow_contract.py (SHW009_PIN); the pool is re-provisioned
# from this image so the pin can ratchet DOWN. patch is for node-gyp's apply step.
#
# 🚨 THIS COMMENT LIVES ABOVE THE RUN, AND MUST STAY THERE. It sat INSIDE the
# command until 2026-09-09, between `git curl jq unzip \` and the toolchain. A
# backslash continuation joins the lines, so the `#` commented out the remainder
# of the joined command -- gcc, gcc-c++, make, patch AND `dnf clean all` never
# ran. The image built fine and reported success; the toolchain was simply
# absent, which is the exact SHW009 symptom the comment describes as fixed.
# The warning against this shape was written four lines above the line that did
# it. check_awnix_variants.py AWV007 is what actually catches it.
RUN dnf install -y --setopt=install_weak_deps=False \
        podman buildah skopeo crun \
        slirp4netns fuse-overlayfs \
        git curl jq unzip \
        gcc gcc-c++ make patch \
    && dnf clean all

# CentOS Stream 9's DEFAULT `python3` is 3.9.25 (kept old on purpose — it's
# the system python dnf/yum depend on, never touch it). All 19 aw* tools
# declare `requires-python >= 3.10` (measured live 2026-08-20: pip on 3.9
# reports "Could not find a version that satisfies the requirement awgit
# (from versions: none)" even though the PyPI index answers fine — every
# candidate wheel is silently filtered by the python-version constraint, and
# pip's error names no version rather than the real cause). RHEL/CentOS 9
# ships python3.11 as an ADDITIONAL package for exactly this case.
RUN dnf install -y --setopt=install_weak_deps=False python3.11 python3.11-pip \
    && dnf clean all

# ── PowerShell 7 and AitherZero, in the BASE ────────────────────────────────
#
# Owner decision 2026-08-21: pwsh 7 by DEFAULT, everywhere -- local, cloud and
# every automation. Every image in this family derives from this file
# (awnix-full, awnix-runner, awnix-runner-ai, base -> desktop -> gpu-nvidia ->
# aitheros), so installing it here is the only place that means ALL of them.
# It was briefly added to awnix-full alone, which would have left the runner
# and appliance lines without it and made 'pwsh is available' true in one
# variant and false in the rest -- the kind of difference nobody notices until
# a script runs on the wrong box.
#
# AitherZero is a PowerShell 7 module (PowerShellVersion = '7.0'), so it cannot
# be here without pwsh; the two arrive together or not at all. Installed to the
# shared module path so `Import-Module AitherZero` resolves with no profile
# edit and no PSModulePath juggling -- a repo root on PSModulePath is its own
# documented tax.
#
# Both PINNED: an image that resolves differently on every rebuild is not
# immutable, which is the property awnix sells. The RPM URL is verified to
# exist before pinning rather than guessed -- a 404 here fails the build long
# after it started.
ARG PWSH_VERSION=7.4.6
# ARCH-AWARE, and NOT by parameterising the RPM URL — which is the obvious fix
# and a broken one. The base image is genuinely multi-arch (verified 2026-08-23:
# quay.io/centos-bootc/centos-bootc:c9s publishes linux/amd64, linux/arm64,
# ppc64le and s390x), so this RPM line was the only thing pinning awnix to
# x86_64. But PowerShell publishes **no aarch64 RPM**: measured for 7.4.6,
#   powershell-7.4.6-1.rh.x86_64.rpm    -> 200
#   powershell-7.4.6-1.rh.aarch64.rpm   -> 404
#   powershell-7.4.6-1.rh.arm64.rpm     -> 404
#   powershell-7.4.6-linux-arm64.tar.gz -> 200
# so `s/x86_64/${TARGETARCH}/` produces a 404 that fails the build long after it
# started — the exact failure this block's own comment warns about. arm64 takes
# the tarball instead.
#
# x86_64 keeps the RPM path unchanged on purpose: it is the verified, pinned,
# shipping path, and rewriting it to the tarball for symmetry would risk the
# only build that currently works in order to tidy the one that does not.
ARG TARGETARCH
RUN set -eux; \
    case "${TARGETARCH:-$(uname -m)}" in \
      amd64|x86_64) \
        dnf install -y --setopt=install_weak_deps=False \
          "https://github.com/PowerShell/PowerShell/releases/download/v${PWSH_VERSION}/powershell-${PWSH_VERSION}-1.rh.x86_64.rpm" \
        && dnf clean all ;; \
      arm64|aarch64) \
        dnf install -y --setopt=install_weak_deps=False tar gzip libicu openssl-libs \
        && dnf clean all \
        && mkdir -p /opt/microsoft/powershell/7 \
        && curl -fsSL -o /tmp/pwsh.tar.gz \
             "https://github.com/PowerShell/PowerShell/releases/download/v${PWSH_VERSION}/powershell-${PWSH_VERSION}-linux-arm64.tar.gz" \
        && tar zxf /tmp/pwsh.tar.gz -C /opt/microsoft/powershell/7 \
        && rm -f /tmp/pwsh.tar.gz \
        && chmod +x /opt/microsoft/powershell/7/pwsh \
        && ln -sf /opt/microsoft/powershell/7/pwsh /usr/bin/pwsh ;; \
      *) echo "awnix: unsupported TARGETARCH '${TARGETARCH}'" >&2; exit 1 ;; \
    esac; \
    pwsh --version

# From the published RELEASE, not a clone of the repo's default branch.
#
# `Aitherium/AitherZero` is a CURATED PARTIAL mirror: its own SYNC-MANIFEST.yaml
# syncs `library/automation-scripts` for seven safe categories and nothing else,
# so the tree carries no `AitherZero.psd1` and no `.psm1` ANYWHERE -- measured,
# not assumed. Cloning it into a Modules directory produces a directory that is
# not a module, and the next line dies with "no valid module file was found in
# any module directory".
#
# This image did exactly that until the layers were RUN against the real base.
# Every cheap signal was green: the repo exists, the clone succeeds, the layer
# is well-formed, and the module imports fine on a developer machine -- from a
# copy of the PRIVATE monorepo tree installed there, which is not what this
# image would have had. Reading the Containerfile cannot see it, and checking
# that the URL resolves cannot see it. Only building it can.
#
# The release zip carries AitherZero.psd1 and AitherZero.psm1 at its ROOT, which
# is what a PowerShell module directory has to look like. It is public,
# versioned and pinnable -- a branch is none of those.
ARG AITHERZERO_VERSION=2.3.5
RUN curl -fsSL -o /tmp/aitherzero.zip \
        "https://github.com/Aitherium/AitherZero/releases/download/v${AITHERZERO_VERSION}/AitherZero-${AITHERZERO_VERSION}.zip" \
    && mkdir -p /usr/local/share/powershell/Modules/AitherZero \
    && unzip -q /tmp/aitherzero.zip -d /usr/local/share/powershell/Modules/AitherZero \
    && rm -f /tmp/aitherzero.zip

# (An AZ_LINUX_PLUGIN_GUARD sed lived here until 2026-08-22, patching the
#  published module because every release up to 2.3.4 failed to import on
#  any host with no plugins directory. v2.3.5 carries the fix -- verified
#  importing UNPATCHED in this base image -- so the patch is gone with the
#  pin above. Re-pinning BELOW 2.3.5 reintroduces the bug; the
#  Import-Module assertion below is what will tell you.)

# Assert it IMPORTS, not merely that files landed. A module that unpacked and a
# module that loads are different facts, and the difference otherwise shows up
# on the user's machine at the moment they reach for it.
RUN pwsh -NoProfile -Command "Import-Module AitherZero -ErrorAction Stop; \
    (Get-Module AitherZero).Version.ToString()"

COPY storage.conf /etc/containers/storage.conf

# The aw* tools — installed from PyPI (the real, published packages), never
# COPYed from the monorepo. Copying source would couple a public, forkable
# base image to our tree; pip installing the same artifact anyone else gets
# is what "standalone" means (aw-family doctrine: "Client, not lift").
# ecosystem.yaml's own awrecover entry documents `pip install awrecover` as
# the real install command — that claim was checked live 2026-08-20 and is
# CURRENTLY FALSE for 2 of the 7: `awrecover` and `awseal` both 404 on
# PyPI (awgit, awgraph, awrelay, awm, awshare are all real, HTTP 200).
# Installing only what's actually published — per this codebase's own
# "absent is a status, not an omission" doctrine (aw-family.md) — rather
# than silently dropping the gap or blocking the whole build on it.
RUN python3.11 -m pip install --no-cache-dir awdit \
        awgit awgraph awrelay awm awshare

# ...and the two that are NOT on PyPI, from source. That TODO is now closed.
#
# The gap was never readiness. PyPI caps how many projects an account may create and
# we ran out of slots, so `awrecover` and `awseal` 404 on the index while being
# perfectly real, with public repos at github.com/Aitherium (both verified 200 on
# 2026-08-21). Reading that 404 as 'not ready yet' is what left this image shipping
# FIVE of the seven aw* tools while its own LABEL below claims seven.
#
# Pinned to a branch rather than floating on a default: an image that resolves
# differently on every rebuild is not immutable, which is the one property awnix
# sells. Bump these deliberately.
#
# `git` is installed above, so a git+https target resolves without another layer.
RUN python3.11 -m pip install --no-cache-dir \
        "git+https://github.com/Aitherium/awrecover.git@main" \
        "git+https://github.com/Aitherium/awseal.git@main"

# ── the senses, plus the two that guard and wake things ─────────────────────────────
#
# awvoice (hear/speak), awvision (see an image), awscreen (see this machine),
# awwall (egress allowlist, fail-closed) and awrise (wake on a schedule). Built
# 2026-08-24 and mirrored the same day.
#
# Same git+https shape and the same reason as the two above: PyPI caps how many
# projects an account may create, these have no slot, so the index 404s while the
# code is real and the repos are public.
#
# WHY THESE FIVE AND NOT A LONGER LIST. An image that installs a tool nobody can
# reach is the failure this file already records about ITSELF -- it shipped FIVE of
# seven while claiming seven. So the rule is: a name goes in this block only once
# its repo answers an UNAUTHENTICATED clone. All five were cloned and their
# pyproject.toml confirmed BEFORE this line was written. A private repo answers 404
# to that clone exactly like a repo that does not exist, and the build then dies
# ~15 minutes in with a message naming neither cause.
#
# Asserted now, not just described: AitherOS/dev/tools/check_awnix_ships_claim.py
# ANS001 compares the count this file ADVERTISES against the count it INSTALLS, and
# ANS002 --online checks every target here still resolves. Add a name here and the
# "aw* tools" count in the comments must move with it, or the gate says so.
#
# Pinned to @main deliberately, like the two above: an image that resolves
# differently on every rebuild is not immutable, which is the one property awnix
# sells.
RUN python3.11 -m pip install --no-cache-dir \
        "git+https://github.com/Aitherium/awvoice.git@main" \
        "git+https://github.com/Aitherium/awvision.git@main" \
        "git+https://github.com/Aitherium/awscreen.git@main" \
        "git+https://github.com/Aitherium/awrise.git@main" \
        "git+https://github.com/Aitherium/awwall.git@main" \
        "git+https://github.com/Aitherium/awbrain.git@main"

# awbrain, added 2026-09-12. The registry has listed it in awnix.includes
# since the entry was written, and THIS file never installed it -- so every
# surface reading the registry said the base carries the history-as-wiki
# runtime and the base did not. AIC004 is what surfaced it.
#
# It qualifies under this file's own rule ("a name goes in this block only
# once its repo answers an UNAUTHENTICATED clone"): measured 2026-09-12,
# `git ls-remote https://github.com/Aitherium/awbrain.git HEAD` succeeds,
# the repo is public, and its pyproject name is `awbrain`. The alternative
# -- deleting it from `includes` to make the gate green -- answers "not on
# the box" when the true answer is "nobody added it", and leaves awbrain
# composed with nothing at all.

# ── the functional OS ───────────────────────────────────────────────────────────────
#
# OWNER CALL, 2026-09-12: "it should be like a functional linux os with networking,
# web browser, agents, awsh/shell etc", and "native AitherMesh / AitherNet
# capabilities too". Before this layer the base carried thirteen capability bricks
# and NONE of the surface that makes an OS usable: no agent runtime, no shell, no
# browser tool, no mesh. Every one of them existed -- in `awnix-full`, one variant
# up. The base built, booted, and could not be used without a second image.
#
# Each target below was checked before it was written here, by the rule this file
# already states for its own block (an UNAUTHENTICATED clone, or the index):
#
#   awdk      PyPI 200          the agent runtime -- the thing that CALLS the rest
#   awbrowse  PyPI 200          the browser brick. The Obscura ENGINE is already in
#                               this file; the tool that drives it was the missing half.
#   awnode    PyPI 200          serve inference on this box instead of a vendor URL
#   awnet     clone succeeds    AitherNet: host a mesh here, join from anywhere
#   awtunnel  clone succeeds    expose one local port to one remote caller
#
# `awsh` is npm, and it is the ONLY npm channel in the family -- so this layer adds
# the node runtime with it. A "functional OS" whose shell cannot install is the
# shape this file already records about itself.
# Stream 9's DEFAULT nodejs stream is 16; @aitherium/awsh is ESM-only and needs >= 18
# (engines). The old image installed it and never ran it, so nothing noticed; the
# build-time `awnix-awsh --self-test` / `awsh --version` then died on an ESM loader
# stack (run 36495471093). Pin the module stream and assert the major.
RUN dnf module -y reset nodejs \
    && dnf module -y enable nodejs:20 \
    && dnf install -y --setopt=install_weak_deps=False nodejs npm \
    && node -e 'if (+process.versions.node.split(".")[0] < 18) { console.error("node " + process.version + " < 18"); process.exit(1) }' \
    && dnf clean all

RUN python3.11 -m pip install --no-cache-dir \
        awdk awbrowse awnode

RUN python3.11 -m pip install --no-cache-dir \
        "git+https://github.com/Aitherium/awnet.git@main" \
        "git+https://github.com/Aitherium/awtunnel.git@main"

# Pinned, same as awnix-full: the BUSL-1.1 text this image ships
# (licenses/LICENSE.BUSL-1.1.awsh) is the one the 1.19.0 package carries, and an
# unpinned install could ship a later release under a text nobody compared (D-2742).
# `rm -f` the bins first so a re-run cannot die on npm EEXIST; assert all three resolve.
RUN rm -f /usr/local/bin/aither /usr/local/bin/aither-shell /usr/local/bin/awsh \
    && npm install -g @aitherium/awsh@1.19.0 \
    && command -v aither && command -v aither-shell && command -v awsh

# ── first-boot setup ────────────────────────────────────────────────────────────────# The thing that turns "an image that builds" into "an OS someone can install": the
# questions every Linux asks after install -- hostname, which optional components, and
# whether to link this box to a fleet. All three are declinable, because awnix's whole
# posture is "No services. No agent. No account." and a setup that demanded an account
# to finish would contradict the product.
#
# The component menu is PROBED at runtime, never printed from a hardcoded list.
# Measured 2026-08-21: only 10 of the 26 aw* packages in the monorepo are on PyPI, and
# the missing ones (awrun, awtunnel, awiam, awseal, awrecover...) sound exactly as real
# as the present ones. A first-boot menu offering a `pip install` that 404s is the worst
# possible place for the ONB003 class -- it is the user's first five minutes with the OS.
COPY awnix-setup.py /usr/bin/awnix-setup
# The catalogue awnix-setup reads. GENERATED by
# AitherOS/dev/tools/gen_installer_catalogue.py from ecosystem.yaml,
# services.yaml and AitherZero's config.psd1 -- staged here because this
# image does not carry AitherOS/config/, and awnix-setup REFUSES to start
# without it rather than falling back to a built-in list that would be
# wrong and look right.
COPY awnix-catalogue.yaml /usr/local/sbin/awnix-catalogue.yaml
COPY awnix-setup.service /usr/lib/systemd/system/awnix-setup.service
RUN chmod 0755 /usr/bin/awnix-setup     && systemctl enable awnix-setup.service

# ── OS roles: `awnix role list|status|add|remove|configure` + the licence gate ──────
# Every role unit generate_os_roles.py emits carries
#   ExecStartPre=/usr/libexec/aither/role-entitlement-check <Service> <class>
# and until 2026-09-28 that script existed NOWHERE, so any unit that used it could not
# start. core/internal roles fail OPEN (the free floor an unlicensed box serves);
# addon:<pack> roles fail CLOSED without /etc/aither/appliance.lic granting the pack --
# awnix_role.decide() carries the reasoning. The catalog is GENERATED from
# AitherOS/config/os_roles.yaml by check_os_role_catalog.py --write-catalog (ROLE014
# fails when it drifts), staged here for the same reason as awnix-catalogue.yaml.
COPY awnix_role.py /usr/lib/awnix/awnix_role.py
COPY role-entitlement-check /usr/libexec/aither/role-entitlement-check
# The role CLI is the `awnix role` VERB: /usr/bin/awnix is the dispatcher (appliance plane
# below), which execs /usr/libexec/awnix/awnix-role; the script answers to either name.
COPY awnix /usr/libexec/awnix/awnix-role
COPY awnix-role-catalog.json /usr/share/aither/roles/catalog.json
# The per-role unit TEMPLATES (check_os_role_catalog.py --write-templates, ROLE017 fails
# on drift): what `awnix role add` installs on a box WITHOUT the monorepo generator.
# Data binds live under /var/lib/aitheros (bootc's writable /var); monorepo overlays
# and operator-host binds are dropped and listed in each role's manifest.json.
COPY awnix-role-units /usr/share/aither/roles/units
# /var/lib/awnix/backups 0700: hook backups carry key material and DIT hashes.
COPY awnix-role.tmpfiles.conf /usr/lib/tmpfiles.d/awnix-role.conf
RUN chmod 0644 /usr/lib/awnix/awnix_role.py /usr/share/aither/roles/catalog.json \
    && chmod -R a+rX /usr/share/aither/roles/units \
    && chmod 0755 /usr/libexec/aither/role-entitlement-check /usr/libexec/awnix/awnix-role \
    && mkdir -p /etc/awnix /etc/aither/roles

# ── self-healing updates ─────────────────────────────────────────────────────────────
# `bootc upgrade` stages a whole new image and keeps the old one, so an update can
# always be undone by `bootc rollback`. greenboot makes that AUTOMATIC: every boot runs
# the required health checks, and a freshly updated deployment that fails them
# GREENBOOT_MAX_BOOT_ATTEMPTS times in a row rolls itself back to the previous image.
# An update that breaks the box undoes itself -- nobody lands in emergency mode.
#
# Only greenboot itself is installed, NOT greenboot-default-health-checks: its DNS
# check fails any box that boots offline and would roll back a laptop for being on a
# plane. awnix-health-check.sh asserts what an update can break and a location cannot.
# Every unit greenboot ships with an [Install] section is enabled, and the build FAILS
# if the health check did not end up enabled -- a silently absent rollback is worse
# than none, because the docs would promise it.
RUN dnf install -y --setopt=install_weak_deps=False greenboot \
    && dnf clean all \
    && for u in $(rpm -ql greenboot | grep -E '/systemd/system/[^/]+\.(service|target)$'); do \
         grep -q '^\[Install\]' "$u" && systemctl enable "$(basename "$u")"; \
       done; \
    systemctl is-enabled greenboot-healthcheck.service
COPY awnix-health-check.sh /etc/greenboot/check/required.d/10-awnix-core.sh
RUN chmod 0755 /etc/greenboot/check/required.d/10-awnix-core.sh \
    && mkdir -p /etc/greenboot \
    && printf 'GREENBOOT_MAX_BOOT_ATTEMPTS=3\n' > /etc/greenboot/greenboot.conf

# ── the appliance plane ─────────────────────────────────────────────────────────────
# What makes an awnix box administrable by someone who is not us: activation (the
# `aitheros` CLI, the license units), the web console on :9443 and its `awnix`
# dispatcher, signed channel updates, add-on components from a pinned lock, the
# repointable outbound endpoints, the first-boot setup steps, and the admin docs.
# Installed HERE, in the base, because every variant (garg and aitheros included)
# derives from this file -- a plane added one layer up is a plane half the images lack.
#
# man-db + groff-base so `man awnix` works on an offline box. BEFORE the identity block
# below: a later dnf transaction can revert /usr/lib/os-release (Containerfile.aitheros
# records that it happened once).
RUN dnf install -y --setopt=install_weak_deps=False man-db groff-base \
    && dnf clean all

# cosign verifies every digest `awnix update check` stages. Installed from the pinned,
# sha256-checked release by sign-awnix-image.sh -- the same trust the signing lane uses.
# A box without cosign REFUSES to update; it never stages an unverified image.
COPY sign-awnix-image.sh /usr/libexec/awnix/sign-awnix-image.sh
RUN sed -i 's/\r$//' /usr/libexec/awnix/sign-awnix-image.sh \
    && bash /usr/libexec/awnix/sign-awnix-image.sh install /usr/bin \
    && cosign version >/dev/null

# The CLIs. Verbs live at /usr/libexec/awnix/awnix-<verb> and `awnix <verb>` execs them
# (contract awnix-dispatcher-and-cli-conventions); the console's issue helper keeps its
# own name so the dispatcher never offers it as a verb.
COPY aitheros-cli.py /usr/bin/aitheros
COPY awnix-dispatch.sh /usr/bin/awnix
COPY awnix-license.sh /usr/libexec/awnix/awnix-license
COPY awnix-console.py /usr/libexec/awnix/awnix-console
COPY awnix-doctor.sh /usr/libexec/awnix/awnix-doctor
COPY awnix-console-issue.sh /usr/libexec/awnix/awnix-console-issue.sh
COPY awnix-update.sh /usr/libexec/awnix/awnix-update
COPY awnix-component.py /usr/libexec/awnix/awnix-component
COPY awnix-endpoints.py /usr/libexec/awnix/awnix-endpoints
COPY awnix_console /usr/lib/awnix-console/awnix_console
COPY awnix_setup /usr/lib/awnix-setup/awnix_setup

# Activation: the verifier key (public half only), the refresh units and their dirs.
COPY license-pubkey.pem /usr/share/aither/license-pubkey.pem
COPY aither-license.service aither-license.timer aither-license.path /usr/lib/systemd/system/
COPY aither-license.tmpfiles.conf /usr/lib/tmpfiles.d/aither-license.conf

# The console: unit, vendor defaults, the built web bundle, the surfaces matrix.
COPY awnix-console.service /usr/lib/systemd/system/awnix-console.service
COPY awnix-console.conf /usr/lib/awnix/console.conf
COPY awnix-web/dist /usr/share/awnix-console
COPY awnix-surfaces.yaml /usr/share/awnix/surfaces.yaml

# First-boot steps every variant asks (license, update channel, auto-apply).
COPY setup-steps/common/ /usr/share/awnix-setup/steps.d/

# Outbound endpoints: the vendor floor an admin overrides in /etc/awnix/endpoints.env.
COPY awnix-endpoints.env /usr/lib/awnix/endpoints.env

# Signed updates: channel config, the six-hourly unit, the signer identities, and the
# containers/image trust + sigstore-attachment config.
COPY awnix-update.conf /etc/awnix/update.conf
COPY awnix-update.service awnix-update.timer /usr/lib/systemd/system/
COPY awnix-signers.conf /usr/share/awnix/signers.conf
COPY containers-policy.json /etc/containers/policy.json
COPY registries.d-aitherium.yaml /etc/containers/registries.d/aitherium.yaml

# Components: the lock baked into THIS image, its state dirs, and the boot-time sync.
COPY awnix-components.lock.yaml /usr/share/awnix/components.lock.yaml
COPY awnix-components.lock.json /usr/share/awnix/components.lock.json
COPY awnix-components.tmpfiles.conf /usr/lib/tmpfiles.d/awnix-components.conf
COPY awnix-component-sync.service /usr/lib/systemd/system/awnix-component-sync.service

# The admin docs source; rendered below into man, HTML and the console's guide.json.
COPY docs /usr/share/awnix-docs-src

# ── the AFRL / air-gap plane (wave 2, integrated at awnix-complete 2026-09-28) ─────
# What an air-gapped, self-serviced box needs beyond the appliance plane: the license
# lifecycle (expiry never stops serving; after 30 days of grace only vendor pulls stop),
# offline signed updates from removable media, mesh join, backup/restore/reset, the AFRL
# proof harness, Secure Boot state, greenboot's automatic fallback, awsh wired offline,
# and the ops floor (no-egress chrony, bounded journald/logrotate, a clock floor).
# The COPYs land BEFORE the plane's RUN below, so its CR strip, chmod and the steps
# validator (setup-steps/common/45-secureboot.json names awnix-secureboot) cover them.
# Every verb lands in /usr/libexec/awnix, so `awnix <verb>` reaches it with no dispatcher
# edit. The zero-open-ports profile is NOT here: it is the Containerfile.awnix-airgap
# layer on top of any base (console, garg and sshd pinned to loopback, default-deny zone).
RUN dnf install -y --setopt=install_weak_deps=False chrony logrotate mokutil tcpdump iproute \
    && dnf clean all
COPY ops/awnix-chrony.conf /etc/chrony.d/50-awnix.conf
COPY ops/awnix-journald.conf /usr/lib/systemd/journald.conf.d/50-awnix.conf
COPY ops/awnix-logrotate.conf /etc/logrotate.d/awnix
COPY ops/logrotate-hourly.conf /usr/lib/systemd/system/logrotate.timer.d/50-awnix-hourly.conf
COPY ops/awnix-ops-doctor.py /usr/libexec/awnix/awnix-ops-doctor
COPY ops/greenboot-50-awnix-ops.sh /etc/greenboot/check/wanted.d/50-awnix-ops.sh
COPY awnix-renewal.py /usr/libexec/awnix/awnix-renewal
COPY license-lifecycle.json /usr/share/aither/license-lifecycle.json
COPY aither-license-lifecycle.service aither-license-lifecycle.timer /usr/lib/systemd/system/
COPY aither-license-lifecycle.tmpfiles.conf /usr/lib/tmpfiles.d/aither-license-lifecycle.conf
COPY awnix-offline-update.py /usr/libexec/awnix/awnix-offline-update
COPY awnix-offline-update.tmpfiles.conf /usr/lib/tmpfiles.d/awnix-offline-update.conf
COPY offline-trust.d/ /usr/share/awnix/offline-trust.d/
COPY awnix-mesh.py /usr/libexec/awnix/awnix-mesh
COPY awnix-mesh.service /usr/lib/systemd/system/
COPY awnix-mesh.path /usr/lib/systemd/system/
COPY awnix-mesh.timer /usr/lib/systemd/system/
COPY awnix-mesh.tmpfiles.conf /usr/lib/tmpfiles.d/awnix-mesh.conf
COPY awnix-mesh.nm-dispatcher /usr/lib/NetworkManager/dispatcher.d/90-awnix-mesh
COPY awnix-mesh-zone.xml /usr/lib/firewalld/zones/awnix-mesh.xml
COPY awnix-backup.py /usr/libexec/awnix/awnix-backup
COPY awnix-restore.sh /usr/libexec/awnix/awnix-restore
COPY awnix-reset.sh /usr/libexec/awnix/awnix-reset
COPY backup.d/00-awnix.json /usr/lib/awnix/backup.d/00-awnix.json
COPY awnix-backup.tmpfiles.conf /usr/lib/tmpfiles.d/awnix-backup.conf
COPY proof/awnix-proof.py /usr/libexec/awnix/awnix-proof
COPY proof/awnix_proof /usr/lib/awnix/proof/awnix_proof
COPY proof/awnix_proof_verify.py /usr/lib/awnix/proof/awnix_proof_verify.py
COPY awnix-secureboot.py /usr/libexec/awnix/awnix-secureboot
COPY awnix-secureboot.service /usr/lib/systemd/system/awnix-secureboot.service
COPY awnix-greenboot-fallback.sh /usr/libexec/awnix/awnix-greenboot-fallback.sh
COPY awnix-greenboot-fallback.service /usr/lib/systemd/system/awnix-greenboot-fallback.service
COPY awnix-greenboot-fallback.conf /usr/lib/systemd/system/greenboot-healthcheck.service.d/50-awnix-greenboot-fallback.conf
COPY awsh/shell.yaml /usr/lib/awsh/shell.yaml
COPY awsh/awsh-harness.service awsh/awsh-agent.service /usr/lib/systemd/user/
COPY awsh/awsh-offline.sh /etc/profile.d/awsh-offline.sh
COPY awsh/awnix-awsh.py /usr/libexec/awnix/awnix-awsh

# ONE RUN proves the plane, and every step of it is an assertion (the garg CRLF lesson:
# a source fix that never reached the image reads as fixed). It CR-strips every installed
# script and data file, asserts the python3.11 shebangs, writes release.env (a variant
# layer overrides it), runs every CLI's self-test and the steps validator, checks the
# dispatcher offers each verb, enables the plane's units and MASKS the stock bootc
# updater (it pulls a tag unverified and reboots on its own), renders the public docs and
# asserts `man` finds them. Prose lives HERE, above the RUN (AWV007).
ARG AWNIX_VARIANT=awnix
ARG AWNIX_IMAGE_REPO=ghcr.io/aitherium/awnix
RUN set -eu; \
    chmod 0755 /usr/bin/aitheros /usr/bin/awnix /usr/libexec/awnix/*; \
    for f in /usr/bin/aitheros /usr/bin/awnix /usr/bin/awnix-setup /usr/libexec/awnix/*; do \
        sed -i 's/\r$//' "$f"; \
    done; \
    find /usr/lib/awnix-console /usr/lib/awnix-setup /usr/share/awnix-setup /usr/share/awnix-docs-src \
        /usr/share/awnix /usr/lib/awnix /etc/awnix -type f -exec sed -i 's/\r$//' {} +; \
    sed -i 's/\r$//' /usr/lib/systemd/system/aither-license.service \
        /usr/lib/systemd/system/aither-license.timer /usr/lib/systemd/system/aither-license.path \
        /usr/lib/systemd/system/awnix-console.service /usr/lib/systemd/system/awnix-update.service \
        /usr/lib/systemd/system/awnix-update.timer /usr/lib/systemd/system/awnix-component-sync.service \
        /usr/lib/tmpfiles.d/aither-license.conf /usr/lib/tmpfiles.d/awnix-components.conf \
        /etc/containers/policy.json /etc/containers/registries.d/aitherium.yaml; \
    for f in /usr/bin/aitheros /usr/libexec/awnix/awnix-console /usr/libexec/awnix/awnix-component \
             /usr/libexec/awnix/awnix-endpoints /usr/bin/awnix-setup; do \
        head -1 "$f" | grep -qx '#!/usr/bin/python3.11' \
            || { echo "FATAL: $f does not start with #!/usr/bin/python3.11" >&2; exit 1; }; \
    done; \
    mkdir -p /usr/lib/awnix; \
    epoch="${SOURCE_DATE_EPOCH:-$(date -u +%s)}"; \
    printf '%s\n' "$epoch" > /usr/lib/awnix/build-epoch; \
    printf 'AWNIX_VARIANT=%s\nAWNIX_IMAGE_REPO=%s\nAWNIX_BUILD_EPOCH=%s\n' \
        "$AWNIX_VARIANT" "$AWNIX_IMAGE_REPO" "$epoch" > /usr/lib/awnix/release.env; \
    aitheros --self-test >/dev/null; \
    awnix --self-test >/dev/null; \
    /usr/libexec/awnix/awnix-console --self-test >/dev/null; \
    /usr/libexec/awnix/awnix-console-issue.sh --self-test >/dev/null; \
    /usr/libexec/awnix/awnix-doctor --self-test >/dev/null; \
    /usr/libexec/awnix/awnix-update --self-test >/dev/null; \
    /usr/libexec/awnix/awnix-component --self-test >/dev/null; \
    /usr/libexec/awnix/awnix-endpoints --self-test >/dev/null; \
    /usr/bin/awnix-setup --self-test >/dev/null; \
    /usr/bin/awnix-setup --validate-steps /usr/share/awnix-setup/steps.d; \
    verbs=$(awnix --list-verbs); \
    for v in update component license setup console endpoints doctor role renewal \
             offline-update mesh backup restore reset proof secureboot awsh ops-doctor; do \
        printf '%s\n' "$verbs" | grep -qx "$v" \
            || { echo "FATAL: awnix verb $v is not offered by the dispatcher" >&2; exit 1; }; \
    done; \
    systemctl enable aither-license.timer aither-license.path awnix-console.service awnix-update.timer awnix-component-sync.service; \
    systemctl mask bootc-fetch-apply-updates.timer; \
    podman image trust show >/dev/null; \
    test -s /usr/share/awnix-console/index.html; \
    python3.11 /usr/share/awnix-docs-src/awman.py render --src /usr/share/awnix-docs-src \
        --roff /usr/share/man --html /usr/share/doc/awnix/html \
        --json /usr/share/doc/awnix/guide.json --public; \
    man -w 7 awnix >/dev/null && man -w 8 awnix >/dev/null && man -w 8 awnix-setup >/dev/null \
        && man -w 8 awnix-update >/dev/null && man -w 8 awnix-console >/dev/null

# The wave-2 plane, proven the same way: every script CR-stripped BY NAME (a CRLF shebang
# does not execute), python3.11 shebangs asserted (awnix-proof ships `env python3`, which
# is 3.9 on this base), every self-test run, units enabled. chrony keeps NO time source
# (the stock `pool` line is commented out: DNS + UDP 123 egress on an air-gapped box; a
# LAN server goes in /etc/chrony.d/10-awnix-lan.conf) and reads /etc/chrony.d. awsh's
# user units are enabled globally; they bind loopback only (awsh-offline.sh keeps the
# shell offline). The build epoch above is the clock floor (awnix-renewal, ops doctor).
RUN set -eu; \
    sed -i 's/\r$//' /usr/libexec/awnix/awnix-ops-doctor /etc/greenboot/check/wanted.d/50-awnix-ops.sh \
        /usr/libexec/awnix/awnix-renewal /usr/libexec/awnix/awnix-offline-update \
        /usr/libexec/awnix/awnix-mesh /usr/lib/NetworkManager/dispatcher.d/90-awnix-mesh \
        /usr/libexec/awnix/awnix-backup /usr/libexec/awnix/awnix-restore /usr/libexec/awnix/awnix-reset \
        /usr/libexec/awnix/awnix-proof /usr/libexec/awnix/awnix-secureboot \
        /usr/libexec/awnix/awnix-greenboot-fallback.sh /usr/libexec/awnix/awnix-awsh \
        /etc/profile.d/awsh-offline.sh /usr/lib/awsh/shell.yaml \
        /usr/lib/systemd/user/awsh-harness.service /usr/lib/systemd/user/awsh-agent.service \
        /etc/chrony.d/50-awnix.conf /etc/logrotate.d/awnix \
        /usr/lib/systemd/journald.conf.d/50-awnix.conf \
        /usr/lib/systemd/system/logrotate.timer.d/50-awnix-hourly.conf \
        /usr/lib/systemd/system/aither-license-lifecycle.service \
        /usr/lib/systemd/system/aither-license-lifecycle.timer \
        /usr/lib/systemd/system/awnix-mesh.service /usr/lib/systemd/system/awnix-mesh.path \
        /usr/lib/systemd/system/awnix-mesh.timer /usr/lib/systemd/system/awnix-secureboot.service \
        /usr/lib/systemd/system/awnix-greenboot-fallback.service \
        /usr/lib/systemd/system/greenboot-healthcheck.service.d/50-awnix-greenboot-fallback.conf \
        /usr/lib/firewalld/zones/awnix-mesh.xml \
        /usr/lib/tmpfiles.d/aither-license-lifecycle.conf /usr/lib/tmpfiles.d/awnix-offline-update.conf \
        /usr/lib/tmpfiles.d/awnix-mesh.conf /usr/lib/tmpfiles.d/awnix-backup.conf; \
    find /usr/lib/awnix/proof -type f -exec sed -i 's/\r$//' {} +; \
    sed -i '1s|^#!.*python3.*$|#!/usr/bin/python3.11|' /usr/libexec/awnix/awnix-proof; \
    chmod 0755 /usr/libexec/awnix/awnix-ops-doctor /etc/greenboot/check/wanted.d/50-awnix-ops.sh \
        /usr/lib/NetworkManager/dispatcher.d/90-awnix-mesh /usr/libexec/awnix/awnix-proof \
        /usr/libexec/awnix/awnix-greenboot-fallback.sh; \
    for f in /usr/libexec/awnix/awnix-ops-doctor /usr/libexec/awnix/awnix-renewal \
             /usr/libexec/awnix/awnix-offline-update /usr/libexec/awnix/awnix-mesh \
             /usr/libexec/awnix/awnix-backup /usr/libexec/awnix/awnix-proof \
             /usr/libexec/awnix/awnix-secureboot /usr/libexec/awnix/awnix-awsh; do \
        head -1 "$f" | grep -qx '#!/usr/bin/python3.11' \
            || { echo "FATAL: $f does not start with #!/usr/bin/python3.11" >&2; exit 1; }; \
    done; \
    /usr/libexec/awnix/awnix-ops-doctor --self-test >/dev/null; \
    /usr/libexec/awnix/awnix-renewal --self-test >/dev/null; \
    /usr/libexec/awnix/awnix-offline-update --self-test >/dev/null; \
    /usr/libexec/awnix/awnix-mesh --self-test >/dev/null; \
    /usr/libexec/awnix/awnix-backup --self-test >/dev/null; \
    /usr/libexec/awnix/awnix-proof --self-test >/dev/null; \
    python3.11 /usr/lib/awnix/proof/awnix_proof_verify.py --self-test >/dev/null; \
    /usr/libexec/awnix/awnix-secureboot --self-test >/dev/null; \
    /usr/libexec/awnix/awnix-awsh --self-test >/dev/null; \
    printf 'd /var/lib/proof 0700 root root -\n' > /usr/lib/tmpfiles.d/awnix-proof.conf; \
    grep -q '^confdir /etc/chrony.d' /etc/chrony.conf || echo 'confdir /etc/chrony.d' >> /etc/chrony.conf; \
    sed -ri 's/^(pool|server|peer)[[:space:]]/# awnix-airgap: &/' /etc/chrony.conf; \
    systemctl enable aither-license-lifecycle.timer; \
    systemctl enable awnix-mesh.path awnix-mesh.timer; \
    systemctl enable chronyd.service logrotate.timer awnix-secureboot.service; \
    systemctl --global enable awsh-harness.service awsh-agent.service; \
    awsh --version >/dev/null

# ── identity ────────────────────────────────────────────────────────────────────────
# Booted in WSL2 on 2026-08-21 and it said `PRETTY_NAME="CentOS Stream 9"`. True about
# the lineage and useless as identity: nothing a user or a script reads said awnix, so
# `bootc status`, a support question and any telemetry all name the upstream rather than
# what was installed.
#
# /usr/lib/os-release, NOT /etc: in this image /etc/os-release is a symlink to it
# (verified live). Writing /etc/ would replace the symlink with a second file that can
# then disagree with the first.
#
# 🚨 ID STAYS `centos`. Setting ID=awnix broke the ISO build outright:
# bootc-image-builder resolves its distro definition from ID + VERSION_ID
# ("could not find def file for distro awnix-9"), has no --distro override, and
# does NOT fall back to ID_LIKE -- that was already set to "centos rhel fedora"
# and it failed anyway. ID is a toolchain key, not a label. The identity a person
# sees is NAME and PRETTY_NAME, and those say awnix without breaking the build.
#
# VERSION_ID stays "9" and ID_LIKE names the family DELIBERATELY. dnf's $releasever,
# package scripts and ansible's os_family all key on those; an awnix-flavoured
# VERSION_ID would be truthful about us and wrong for every consumer that uses it to
# resolve a repository.
RUN . /usr/lib/os-release \
    && printf '%s\n' \
        'NAME="awnix"' \
        'ID=centos' \
        'ID_LIKE="centos rhel fedora"' \
        'VERSION="9 (awnix)"' \
        'VERSION_ID="9"' \
        'PLATFORM_ID="platform:el9"' \
        'PRETTY_NAME="awnix (built on CentOS Stream 9)"' \
        'ANSI_COLOR="0;36"' \
        'HOME_URL="https://github.com/Aitherium/awnix"' \
        'DOCUMENTATION_URL="https://github.com/Aitherium/awnix"' \
        'BUG_REPORT_URL="https://github.com/Aitherium/awnix/issues"' \
        'AWNIX_BUILT_ON="${PRETTY_NAME}"' \
        > /usr/lib/os-release.new \
    && mv /usr/lib/os-release.new /usr/lib/os-release \
    && grep -q '^NAME="awnix"$' /usr/lib/os-release

# ─── awspec: the spec resolver + renderer every awnix image carries ─────────────
# One engine for every descendant (runner, runner-ai, the appliances, the fleet host):
# a leaf adds only LAYER files under /usr/share/awspec/layers.d, and awspec-render
# turns base + leaf layers + the machine's /etc site overlay into drop-ins and env
# files at boot. A renderer or guard fix is therefore ONE change here, reaching every
# image built FROM this one. Brand-neutral: the engine names no product, host or port.
# Source of truth: AitherOS/lib/core/aither_spec.py (+ schema, base layer), mirrored
# into this build context byte-for-byte (check_aither_spec.py SPEC010).
# Design: docs/architecture/SOVEREIGN-CONFIG-PLANE.md.
#
# The unit keeps default dependencies (never Before=sysinit) and requests a reload
# only with --no-block (ALP005, check_boot_deadlock.py). No layers.d = skipped.
COPY awspec.py /usr/lib/awspec/awspec.py
COPY awspec.schema.json /usr/lib/awspec/awspec.schema.json
COPY awspec-base.yaml /usr/share/awspec/base.yaml
COPY awspec-render.sh /usr/libexec/awspec-render
COPY awspec-render.service /usr/lib/systemd/system/awspec-render.service
RUN python3.11 -m pip install --no-cache-dir pyyaml \
    && printf '#!/bin/sh\nexec /usr/bin/python3.11 /usr/lib/awspec/awspec.py "$@"\n' > /usr/bin/awspec \
    && sed -i 's/\r$//' /usr/libexec/awspec-render /usr/lib/awspec/awspec.py \
    && chmod 0755 /usr/bin/awspec /usr/libexec/awspec-render \
    && /usr/bin/awspec --self-test \
    && /usr/bin/awspec validate --layer /usr/share/awspec/base.yaml \
    && systemctl enable awspec-render.service

# Third-party notices, generated from what THIS image actually installed (rpm + pip), in the
# last layer so nothing installed after it is missed (SSC004). A leaf that installs more
# regenerates them in its own last layer.
# The licence texts this image is labelled with. An image that restricts some use and
# does not carry the text saying so is not something a user can comply with. Each is
# a byte copy of its repo source (AWV013): awnix/LICENSE, awdk/LICENSE and
# .PRODUCTS/.AITHERSHELL/cli/LICENSE (the text the published @aitherium/awsh carries).
COPY licenses/LICENSE.Apache-2.0 licenses/LICENSE.BUSL-1.1.awdk licenses/LICENSE.BUSL-1.1.awsh /usr/share/licenses/awnix/
COPY licenses/THIRD-PARTY-NOTICES.md gen-image-notices.sh /tmp/notices/
RUN sed -i 's/\r$//' /tmp/notices/gen-image-notices.sh \
    && sh /tmp/notices/gen-image-notices.sh --notices /tmp/notices/THIRD-PARTY-NOTICES.md \
    && test -s /usr/share/licenses/awnix/THIRD-PARTY-INVENTORY.tsv \
    && rm -rf /tmp/notices

LABEL com.aitheros.layer="awnix-base" \
      com.aitheros.description="awnix — immutable Linux + the 19 aw* tools, no services/agent/account" \
      org.opencontainers.image.licenses="Apache-2.0 AND BUSL-1.1" \
      com.aitheros.licence-note="Apache-2.0 and MIT aw* packages plus two BUSL-1.1 packages, awdk and @aitherium/awsh, each licensed by Aitherium, LLC with the Additional Use Grant that you may not use the Licensed Work for a Commercial Hosted Service. The Apache-2.0 text and both BUSL-1.1 texts ship in /usr/share/licenses/awnix/."
