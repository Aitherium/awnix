# /usr/lib/awnix/endpoints.env -- vendor endpoint defaults for an awnix box.
#
# Precedence (contract endpoints-env): this file < /etc/awnix/endpoints.env < process
# env. Plain KEY=VALUE, one per line, NO shell expansion, no quotes needed. To repoint a
# box at a mirror or your own control plane, copy the line into /etc/awnix/endpoints.env
# and change it there; this file is part of the image and is replaced on every update.
# An empty value switches the feature off rather than falling back to a default.
#
# `awnix endpoints show --json` prints the merged result and where each value came from;
# `awnix endpoints probe --json` checks which of them answer.

# Device-flow link (awnix-setup step "link this box").
AWNIX_LINK_HOST=https://mcp.aitherium.com
AWNIX_DEVICE_CODE_URL=https://mcp.aitherium.com/auth/device/code
AWNIX_LINK_VERIFY_URL=https://api.aitherium.com/link
# Where a LINKED box's agents (adk, the aither shell) sign in; awnix-setup writes it
# with AWNIX_LINK_HOST's /mcp and /v1 into the admin's ~/.aither on link.
AWNIX_IDENTITY_URL=https://idp.aitherium.com

# Where optional aw* packages come from.
AWNIX_GITHUB_ORG=Aitherium
AWNIX_PYPI=https://pypi.org/pypi

# License -> short-lived registry pull token (aitheros license refresh).
AITHER_LICENSE_EXCHANGE_URL=https://api.aitherium.com/v1/licenses/exchange-pull-token

# Image registry the update plane and component installs pull from.
AWNIX_REGISTRY=ghcr.io/aitherium
# The mesh portal `awnix mesh join` enrolls against (awnix-mesh(8)). EMPTY switches the
# mesh off; an air-gapped enclave points it at its own conductor.
AWNIX_MESH_PORTAL=https://api.aitherium.com
