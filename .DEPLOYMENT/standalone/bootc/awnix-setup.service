[Unit]
# awnix first-boot setup on tty1 -- the questions any Linux asks after install.
#
# ConditionPathExists=! is the "run once" mechanism, and it is deliberately DECLARATIVE:
# the state file the setup writes IS the marker, so "setup finished" and "marker written"
# cannot disagree. awnix-console keys its setup/console mode off the SAME file (AIN008).
# `awnix setup --reset --yes` (or deleting the file) makes the box ask again.
Description=awnix first-boot setup (tty1)
Documentation=man:awnix-setup(8) https://github.com/Aitherium/awnix
ConditionPathExists=!/etc/awnix/setup.json

# NEVER HOLD multi-user.target (AIN011). This used to be Type=oneshot WantedBy=multi-user
# with no RemainAfterExit, so the target -- and on the headless garg appliance everything
# ordered after it -- waited on a human typing at tty1. Type=simple is "started" the moment
# it forks, so the boot finishes, the product answers, and this prompt simply waits.
#
# It owns tty1 while it runs: Conflicts= stops the getty there, and ExecStopPost hands
# tty1 back to a login prompt whether setup finished, was cancelled or crashed.
Wants=network-online.target
After=network-online.target systemd-user-sessions.service awnix-console.service
Conflicts=getty@tty1.service
Before=getty@tty1.service

[Service]
Type=simple
# A seed (installer %post copies it to /etc/awnix/seed.json) is applied by `--tty` itself,
# in the MAIN process. Never as ExecStartPre=: a pre-step is part of the start job that
# multi-user.target waits for, a seeded model download runs up to an hour, the default
# 90 s start timeout would kill it (a '-' prefix does not cover a timeout), fail the unit
# and re-apply the seed every boot (AIN011). A bad seed never stops the prompt.
ExecStart=/usr/bin/awnix-setup --tty
ExecStopPost=-/usr/bin/systemctl --no-block start getty@tty1.service

# It is an interactive prompt, so it needs a real terminal. Without these every input()
# returns EOF and setup "completes" having asked nothing.
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

# A cancelled setup (130) is not a failure; nothing restarts it this boot.
SuccessExitStatus=0 130
Restart=no

[Install]
WantedBy=multi-user.target
