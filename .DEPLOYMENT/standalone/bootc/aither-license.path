[Unit]
# Anything that drops an AITHER1 envelope at the spool (the seed USB at first boot, the
# setup step, the :9443 console's license-import action) triggers a root refresh, which
# verifies it, moves it to /etc/aither/appliance.lic and deletes the spool file.
Description=Watch the appliance license spool
Documentation=man:aitheros(1)

[Path]
# PathChanged only. MakeDirectory= creates the WATCHED path itself as a directory
# (systemd.path), which turned the spool file into a directory on first boot; and
# PathExists= re-fires for as long as the path exists, so a left-over directory would
# trip the trigger limit. tmpfiles (aither-license.conf) makes the parent 0700. A spool
# already present at boot is picked up by aither-license.timer (OnBootSec).
PathChanged=/var/lib/aither/license/incoming.lic
Unit=aither-license.service

[Install]
WantedBy=paths.target
