#!/bin/sh
# awnix-model-serve -- serve the local model the first login chose, on this machine only.
#
# awnix-desktop-firstrun downloads a GGUF and links it as
# ~/.local/share/awnix/models/current.gguf. This is what makes that file the model awsh
# answers from: the PrismML llama-server the image bakes (/opt/bonsai/bin) serves it at
# 127.0.0.1:8199, and awsh's vendor config (/usr/lib/awsh/shell.yaml) dials
# http://127.0.0.1:8199/v1. awnix-model.service runs this for every user who has a model.
#
# --host 127.0.0.1 on purpose: 0.0.0.0 would publish an unauthenticated inference
# server to the network. --reasoning-budget 2048 is not optional: Bonsai's chat template
# opens a <think> block every turn and the engine default never closes it, so the answer
# comes back empty (serve-awnix-bonsai.sh records the measurement). The arguments are
# that script's proven fallback set; AWNIX_CTX widens the window.
#
# Exit: 2 when there is nothing to serve or the image carries no server.
set -u
gguf="$HOME/.local/share/awnix/models/current.gguf"
port="${AWNIX_MODEL_PORT:-8199}"
if [ ! -s "$gguf" ]; then
    echo "awnix-model-serve: no model chosen yet ($gguf); run awnix-desktop-firstrun --force" >&2
    exit 2
fi
bin=$(find /opt/bonsai/bin -name llama-server -type f 2>/dev/null | head -1)
if [ -z "$bin" ] || [ ! -x "$bin" ]; then
    echo "awnix-model-serve: llama-server is missing under /opt/bonsai/bin" >&2
    exit 2
fi
exec "$bin" --model "$gguf" --host 127.0.0.1 --port "$port" \
    --ctx-size "${AWNIX_CTX:-16384}" --reasoning-budget 2048 --alias bonsai-selfhost
